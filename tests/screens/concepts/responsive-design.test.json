{
  "$schema": "../../jsonui-test.schema.json",
  "screen": "concepts/responsive-design",
  "description": "Smoke test: Responsive design.",
  "cases": [
    {
      "name": "renders_title",
      "description": "Page mounts and shows the hero title.",
      "steps": [
        {
          "assert": "contains",
          "root": true,
          "text": "Responsive design"
        }
      ]
    },
    {
      "name": "nav_back_home",
      "description": "Tapping the site brand (top-left) returns to home.",
      "steps": [
        {
          "interact": "tap",
          "role": "link",
          "text": "JsonUI"
        },
        {
          "assert": "url",
          "equals": "/"
        }
      ]
    }
  ]
}
