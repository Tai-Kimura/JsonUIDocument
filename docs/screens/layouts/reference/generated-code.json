{
  "type": "View",
  "id": "reference_generated_code_root",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "matchParent",
  "background": "#F9FAFB",
  "child": [
    {
      "data": [
        { "name": "nextReadLinks", "class": "CollectionDataSource" },
        { "name": "onNavigateReference", "class": "() -> Void" },
        { "name": "onNavigateCliCommands", "class": "() -> Void" },
        { "name": "onNavigatePlatformsSwift", "class": "() -> Void" },
        { "name": "onNavigatePlatformsKotlin", "class": "() -> Void" }
      ]
    },
    {
      "type": "Scroll",
      "id": "reference_generated_code_scroll",
      "width": "matchParent",
      "weight": 1,
      "child": [
        {
          "type": "View",
          "orientation": "vertical",
          "id": "reference_generated_code_header",
          "width": "matchParent",
          "height": "wrapContent",
          "paddings": [24, 32, 24, 32],
          "child": [
            {
              "type": "Label",
              "height": "wrapContent",
              "width": "wrapContent",
              "fontSize": 13,
              "fontWeight": "semibold",
              "fontColor": "#64748B",
              "tapBackground": "#F3F4F6",
              "onClick": "@{onNavigateReference}",
              "text": "breadcrumb"
            },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 36, "fontWeight": "bold", "fontColor": "#0B1220", "text": "title" },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 17, "fontColor": "#475467", "text": "lead" },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 13, "fontColor": "#64748B", "text": "read_time" }
          ]
        },
        {
          "type": "View",
          "id": "reference_generated_code_content_with_rail",
          "orientation": "horizontal",
          "width": "matchParent",
          "height": "wrapContent",
          "child": [
            {
              "type": "View",
              "id": "reference_generated_code_body_column",
              "orientation": "vertical",
              "weight": 1,
              "height": "wrapContent",
              "child": [
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_artifacts",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_artifacts_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_artifacts_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "Artifact                        | Written by       | Hand-editable | Carries @generated\n--------------------------------+------------------+---------------+-------------------\nLayout JSON (layouts_directory) | you              | yes           | no\nLayout JSON (platform copy)     | jui build        | no            | yes (_generated)\n*GeneratedView.swift / .kt      | sjui / kjui      | no            | no (size-gated)\nView TSX (web)                  | rjui             | no            | yes\nViewModel / Repository stubs    | jui g project    | yes, once     | header only\nDTO + Domain scaffolds          | jui build (api)  | Domain only   | DTO yes",
                      "language": "text",
                      "filename": "what the build writes",
                      "showLineNumbers": false,
                      "copyable": false
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_artifacts_note" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_bounds",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_bounds_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_bounds_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 14, "fontColor": "#475467", "text": "section_bounds_bullet_depth" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_bounds_bullet_lines" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_bounds_bullet_waiver" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_erasure",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_erasure_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_erasure_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "partialAttributes": [{"range": "/platforms/swift", "fontColor": "accent", "underline": {"lineStyle": "Single"}, "onclick": "onNavigatePlatformsSwift"}], "text": "section_erasure_note" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_android",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_android_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_android_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "partialAttributes": [{"range": "/platforms/kotlin", "fontColor": "accent", "underline": {"lineStyle": "Single"}, "onclick": "onNavigatePlatformsKotlin"}], "text": "section_android_note" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_lint",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_lint_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_lint_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "$ jui lint-generated --fail-on size-ratchet\nChecked 1217 generated files (+58 generated views for the size gate).\n  OK:              1217\n  Missing header:  0\n  Oversized fns:   3 (depth > 5 or lines > 250)\n\nExit codes\n  0  clean\n  1  could not run (no jui.config.json)\n  2  size-ratchet regression — a function grew past the bounds and is\n     not in .jui-size-waivers\n  3  generated-artifact health — a file lost its @generated marker",
                      "language": "bash",
                      "filename": "jui lint-generated",
                      "showLineNumbers": false,
                      "copyable": true
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "partialAttributes": [{"range": "/reference/cli-commands", "fontColor": "accent", "underline": {"lineStyle": "Single"}, "onclick": "onNavigateCliCommands"}], "text": "section_lint_note" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_ratchet",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_ratchet_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_ratchet_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "# jui lint-generated size-waiver baseline (ratchet).\n# One entry per accepted oversized generated function.\napp/src/main/java/.../ChatGeneratedView.kt Section25\napp/src/main/java/.../FormGeneratedView.kt Section0_0_1",
                      "language": "text",
                      "filename": ".jui-size-waivers",
                      "showLineNumbers": false,
                      "copyable": false
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_ratchet_note" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_knobs",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_knobs_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_knobs_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "{\n  \"build\": {\n    \"normalizeLayouts\": true\n  },\n  \"lint\": {\n    \"exclude_dir_names\": [\"Legacy\", \"Sandbox\"],\n    \"exclude_files\": [\"web/src/generated/useColorMode.ts\"],\n    \"max_depth\": 4,\n    \"max_lines\": 200\n  }\n}",
                      "language": "json",
                      "filename": "jui.config.json",
                      "showLineNumbers": false,
                      "copyable": true
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 14, "fontColor": "#475467", "text": "section_knobs_bullet_config" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_knobs_bullet_flags" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_knobs_bullet_env" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_knobs_bullet_fixed" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_warnings",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_warnings_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_warnings_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "What you see                                  | Severity | Where to fix it\n----------------------------------------------+----------+------------------------------\nbinding-double-default, binding-two-way-      | error    | the binding expression\n  complex, binding-negation-context, ...      |          |\nbusiness logic in a binding (ternary, call)   | warning  | move it to the ViewModel\nUnknown attribute 'x' for component type 'y'  | warning  | the attribute, or the SSoT\ncolor not in colors.json; emitting as-is      | warning  | use a palette token\nData property 'x' is defined but never used   | warning  | drop it, or bind it\noversized generated function (iOS)            | warning  | split the layout, or waive\nmissing @generated marker                     | lint     | regenerate (jui build)",
                      "language": "text",
                      "filename": "build diagnostics",
                      "showLineNumbers": false,
                      "copyable": false
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_warnings_note" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "reference_generated_code_next",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [32, 32, 32, 32],
                  "background": "chrome_fill",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 24, "fontWeight": "bold", "fontColor": "chrome_ink", "text": "next_heading" },
                    {
                      "type": "Collection",
                      "id": "reference_generated_code_next_collection",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 20,
                      "columnCount": 3,
                      "lineSpacing": 16,
                      "itemSpacing": 16,
                      "lazy": "none",
                      "scrollEnabled": false,
                      "items": "@{nextReadLinks}",
                      "cellIdProperty": "id",
                      "sections": [
                        { "cell": "cells/next_step_card" }
                      ]
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "reference_generated_code_footer",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 32, 32],
                  "background": "chrome_fill",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 12, "fontColor": "#94A3B8", "text": "footer_copyright" }
                  ]
                }
              ]
            },
            {
              "type": "View",
              "id": "reference_generated_code_rail_column",
              "orientation": "vertical",
              "width": 260,
              "height": "wrapContent",
              "paddings": [24, 16, 24, 16],
              "child": [
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "reference_generated_code_toc_wrap",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 0, 32],
                  "background": "#F9FAFB",
                  "child": [
                    {
                      "type": "TableOfContents",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "title": "toc_title",
                      "sticky": true,
                      "maxDepth": 1,
                      "items": [
                        { "id": "toc_artifacts", "label": "toc_row_artifacts", "anchor": "section_artifacts", "level": 1 },
                        { "id": "toc_bounds", "label": "toc_row_bounds", "anchor": "section_bounds", "level": 1 },
                        { "id": "toc_erasure", "label": "toc_row_erasure", "anchor": "section_erasure", "level": 1 },
                        { "id": "toc_android", "label": "toc_row_android", "anchor": "section_android", "level": 1 },
                        { "id": "toc_lint", "label": "toc_row_lint", "anchor": "section_lint", "level": 1 },
                        { "id": "toc_ratchet", "label": "toc_row_ratchet", "anchor": "section_ratchet", "level": 1 },
                        { "id": "toc_knobs", "label": "toc_row_knobs", "anchor": "section_knobs", "level": 1 },
                        { "id": "toc_warnings", "label": "toc_row_warnings", "anchor": "section_warnings", "level": 1 }
                      ],
                      "stickyOffset": 80
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
