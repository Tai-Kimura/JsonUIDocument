                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "code": "{\n  \"type\": \"View\",\n  \"orientation\": \"vertical\",\n  \"spacing\": 8,\n  \"responsive\": {\n    \"regular\":           { \"orientation\": \"horizontal\", \"spacing\": 24 },\n    \"landscape\":         { \"spacing\": 16 },\n    \"regular-landscape\": { \"orientation\": \"horizontal\", \"spacing\": 32 }\n  },\n  \"child\": [ /* … */ ]\n}",
                      "language": "json",
                      "filename": "layout.json",
                      "showLineNumbers": false,
                      "copyable": true
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_priority",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "fontSize": 26,
                      "fontWeight": "bold",
                      "fontColor": "#0B1220",
                      "text": "section_priority_heading"
                    },
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "fontSize": 16,
                      "fontColor": "#475467",
                      "text": "section_priority_body"
                    },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "code": "// Resolution order, highest priority first:\n//   1. composite key  (compact-landscape, regular-landscape)\n//   2. landscape\n//   3. regular\n//   4. medium\n//   5. compact\n//   6. base attributes (no key)\n//\n// Each step OVERWRITES (not deep-merges) keys from earlier steps.\n// On iPad regular-landscape, given the JSON above, the resolver yields:\n//   orientation: \"horizontal\"   ← from regular-landscape\n//   spacing:     32              ← from regular-landscape\n// On iPhone landscape:\n//   orientation: \"vertical\"      ← from base\n//   spacing:     16              ← from landscape\n// On iPhone portrait:\n//   orientation: \"vertical\"      ← from base\n//   spacing:     8               ← from base",
                      "language": "javascript",
                      "filename": "resolution.txt",
                      "showLineNumbers": false,
                      "copyable": true
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_generated",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "fontSize": 26,
                      "fontWeight": "bold",
                      "fontColor": "#0B1220",
                      "text": "section_generated_heading"
                    },
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "fontSize": 16,
                      "fontColor": "#475467",
                      "text": "section_generated_body"
                    },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "code": "// SwiftUI — the converter lifts the responsive container into a\n// @ViewBuilder helper, then injects the children via `content()`.\n// Children are emitted ONCE; only the wrapper branches.\n@ViewBuilder private func responsiveContentArea<Content: View>(\n    @ViewBuilder content: () -> Content\n) -> some View {\n    if horizontalSizeClass == .regular {\n        HStack(spacing: 24) { content() }\n    } else {\n        VStack(spacing: 8) { content() }\n    }\n}\n\nvar body: some View {\n    responsiveContentArea {\n        section0_0()\n        section0_1()\n    }\n}",
                      "language": "swift",
                      "filename": "Generated.swift",
                      "showLineNumbers": false,
                      "copyable": true
                    },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "// Compose — same pattern. Wrapper is @Composable; children pass through.\n@Composable\nprivate fun ResponsiveContentArea(content: @Composable () -> Unit) {\n    val widthClass = currentWindowAdaptiveInfo().windowSizeClass.windowWidthSizeClass\n    if (widthClass == WindowWidthSizeClass.EXPANDED) {\n        Row(horizontalArrangement = Arrangement.spacedBy(24.dp)) { content() }\n    } else {\n        Column(verticalArrangement = Arrangement.spacedBy(8.dp)) { content() }\n    }\n}",
                      "language": "kotlin",
                      "filename": "Generated.kt",
                      "showLineNumbers": false,
                      "copyable": true
                    },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "{/* React — Tailwind breakpoint prefixes do the work; landscape uses\n    a useMediaQuery hook for the orientation predicate. */}\n<div\n  className={[\n    'flex flex-col gap-2',                  // base / compact\n    'lg:flex-row lg:gap-6',                  // regular\n    isLandscape && 'gap-4',                  // landscape\n    isLandscape && 'lg:flex-row lg:gap-8',   // regular-landscape\n  ]\n    .filter(Boolean)\n    .join(' ')}\n>\n  {children}\n</div>",
                      "language": "tsx",
                      "filename": "Generated.tsx",
                      "showLineNumbers": false,
                      "copyable": true
                    }
                  ]
