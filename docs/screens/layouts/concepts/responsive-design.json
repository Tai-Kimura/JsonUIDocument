                    },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "code": "// One key wins, alone. Priority, highest first:\n//   regular-landscape > medium-landscape > compact-landscape\n//   > landscape > regular > medium > compact > base (no key)\n//\n// Only the winner's overrides go onto the base; the other keys add nothing.\n// Given the JSON above (browser window sizes in CSS px):\n// 1200 x 800  (regular, landscape)  -> regular-landscape wins\n//   orientation: \"horizontal\"   <- regular-landscape\n//   spacing:     32             <- regular-landscape\n// 1200 x 1400 (regular, portrait)   -> regular wins\n//   orientation: \"horizontal\"   <- regular\n//   spacing:     24             <- regular\n// 700 x 400   (compact, landscape)  -> landscape wins\n//   orientation: \"vertical\"     <- base (landscape does not set it)\n//   spacing:     16             <- landscape\n// 390 x 844   (compact, portrait)   -> no key holds\n//   orientation: \"vertical\"     <- base\n//   spacing:     8              <- base\n//\n// Without \"regular-landscape\" in the block, 1200 x 800 goes to landscape\n// alone: orientation \"vertical\" from the base, not regular's \"horizontal\".",
                      "language": "javascript",
                      "filename": "resolution.txt",
                      "showLineNumbers": false,
                      "copyable": true
                    }
                  ]
