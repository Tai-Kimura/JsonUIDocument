                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "code": "// SwiftUI — the converter lifts the responsive container into a\n// @ViewBuilder helper, then injects the children via `content()`.\n// Children are emitted ONCE; only the wrapper branches.\n@ViewBuilder private func responsiveContentArea<Content: View>(\n    @ViewBuilder content: () -> Content\n) -> some View {\n    if horizontalSizeClass == .regular {\n        HStack(spacing: 24) { content() }\n    } else {\n        VStack(spacing: 8) { content() }\n    }\n}\n\nvar body: some View {\n    responsiveContentArea {\n        section0_0()\n        section0_1()\n    }\n}",
                      "language": "swift",
                      "filename": "Generated.swift",
                      "showLineNumbers": false,
                      "copyable": true
                    },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "// Compose — an inline if / else chain at the call site, one branch per key\n// in priority order. No wrapper function: the branch sits in the caller's\n// Row / Column / Box scope and reads data / viewModel directly.\nif (with(LocalDensity.current) { LocalWindowInfo.current.containerSize.width.toDp().value.toInt() } >= 840) {\n    Row(horizontalArrangement = Arrangement.spacedBy(24.dp)) {\n        // children\n    }\n} else {\n    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {\n        // children\n    }\n}",
                      "language": "kotlin",
                      "filename": "Generated.kt",
                      "showLineNumbers": false,
                      "copyable": true
                    },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "{/* React — the JSON from the priority section. Since jsonui-cli 2.3.30 each\n    key is a set of media variants for the windows where it is the winner:\n    portrait: / landscape: with the width bands (lg: is 1024px and wider,\n    max-lg: narrower). Tailwind writes variant classes after the plain ones,\n    so the winner always wins over the base. A block of size classes alone\n    uses breakpoint classes (`lg:` for regular, `md:max-lg:` for medium). */}\n<div className=\"flex flex-col portrait:lg:flex-row portrait:lg:gap-[1.5rem] landscape:max-lg:gap-[1rem] landscape:lg:flex-row landscape:lg:gap-[2rem] gap-[0.5rem]\" />",
                      "language": "tsx",
                      "filename": "Generated.tsx",
                      "showLineNumbers": false,
                      "copyable": true
                    }
