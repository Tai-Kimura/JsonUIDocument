{
  "type": "View",
  "id": "concepts_db_schema_check_root",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "matchParent",
  "background": "#F9FAFB",
  "child": [
    {
      "data": [
        { "name": "nextReadLinks", "class": "CollectionDataSource" },
        { "name": "onNavigateConcepts", "class": "() -> Void" }
      ]
    },
    {
      "type": "Scroll",
      "id": "concepts_db_schema_check_scroll",
      "width": "matchParent",
      "weight": 1,
      "child": [
        {
          "type": "View",
          "orientation": "vertical",
          "id": "concepts_db_schema_check_header",
          "width": "matchParent",
          "height": "wrapContent",
          "paddings": [24, 32, 24, 32],
          "child": [
            { "type": "Label", "width": "wrapContent", "height": "wrapContent", "fontSize": 13, "fontWeight": "semibold", "fontColor": "#64748B", "tapBackground": "#F3F4F6", "onClick": "@{onNavigateConcepts}", "text": "breadcrumb" },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 36, "fontWeight": "bold", "fontColor": "#0B1220", "text": "title" },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 17, "fontColor": "#475467", "text": "lead" },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 13, "fontColor": "#64748B", "text": "read_time" }
          ]
        },
        {
          "type": "View",
          "id": "concepts_db_schema_check_content_with_rail",
          "orientation": "horizontal",
          "width": "matchParent",
          "height": "wrapContent",
          "child": [
            {
              "type": "View",
              "id": "concepts_db_schema_check_body_column",
              "orientation": "vertical",
              "weight": 1,
              "height": "wrapContent",
              "child": [
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_problem",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_problem_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_problem_body" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_docs",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_docs_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_docs_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "code": "{\n  \"openapi\": \"3.0.3\",\n  \"info\": { \"title\": \"users table\", \"x-table-name\": \"users\" },\n  \"components\": {\n    \"schemas\": {\n      \"User\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\":         { \"type\": \"integer\", \"format\": \"int64\",\n                          \"x-primary-key\": true, \"x-auto-increment\": true },\n          \"email\":      { \"type\": \"string\", \"maxLength\": 255, \"x-unique\": true },\n          \"name\":       { \"type\": \"string\", \"maxLength\": 100 },\n          \"bio\":        { \"type\": \"string\", \"nullable\": true },\n          \"role\":       { \"$ref\": \"#/components/schemas/UserRole\" },\n          \"plan_id\":    { \"type\": \"integer\", \"x-index\": true,\n                          \"x-foreign-key\": { \"table\": \"plans\", \"column\": \"id\" } },\n          \"balance\":    { \"type\": \"number\", \"x-db-type\": \"DECIMAL(10,2)\" },\n          \"created_at\": { \"type\": \"string\", \"format\": \"date-time\" }\n        },\n        \"x-indexes\": [\n          { \"columns\": [\"role\", \"created_at\"], \"name\": \"idx_users_role_created\" }\n        ]\n      },\n      \"UserRole\": { \"type\": \"string\", \"enum\": [\"admin\", \"member\", \"guest\"] }\n    }\n  }\n}",
                      "language": "json",
                      "filename": "docs/db/users.json",
                      "showLineNumbers": false,
                      "copyable": true
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_docs_note" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_compared",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_compared_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_compared_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_compared_bullet_tables" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_compared_bullet_columns" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_compared_bullet_constraints" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_compared_bullet_enums" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_declare",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_declare_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_declare_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "code": "{\n  \"databases\": {\n    \"default\": { \"dialect\": \"postgresql\" }\n  },\n  \"checks\": [\n    {\n      \"name\": \"db-schema\",\n      \"type\": \"builtin:db-schema\",\n      \"database\": \"default\",\n      \"ignore_tables\": [\"audit_log_archive\"],\n      \"timeout_seconds\": 60\n    }\n  ]\n}",
                      "language": "json",
                      "filename": "jui.config.json (excerpt)",
                      "showLineNumbers": false,
                      "copyable": true
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_declare_note" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_run",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_run_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_run_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "code": "$ jsonui-doc check --list      # preview the resolved commands, run nothing\n$ jsonui-doc check db          # run only the DB checkers\n$ jsonui-doc check db:default  # narrow to one database",
                      "language": "text",
                      "filename": "running the check",
                      "showLineNumbers": false,
                      "copyable": true
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_run_note" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_limits",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_limits_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_limits_body" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "concepts_db_schema_check_next",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [32, 32, 32, 32],
                  "background": "chrome_fill",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 24, "fontWeight": "bold", "fontColor": "chrome_ink", "text": "next_heading" },
                    {
                      "type": "Collection",
                      "id": "concepts_db_schema_check_next_collection",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 20,
                      "columnCount": 3,
                      "lineSpacing": 16,
                      "itemSpacing": 16,
                      "lazy": "none",
                      "scrollEnabled": false,
                      "items": "@{nextReadLinks}",
                      "cellIdProperty": "id",
                      "sections": [
                        { "cell": "cells/next_step_card" }
                      ]
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "concepts_db_schema_check_footer",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 32, 32],
                  "background": "chrome_fill",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 12, "fontColor": "#94A3B8", "text": "footer_copyright" }
                  ]
                }
              ]
            },
            {
              "type": "View",
              "id": "concepts_db_schema_check_rail_column",
              "orientation": "vertical",
              "width": 260,
              "height": "wrapContent",
              "paddings": [24, 16, 24, 16],
              "child": [
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "concepts_db_schema_check_toc_wrap",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 0, 32],
                  "background": "#F9FAFB",
                  "child": [
                    {
                      "type": "TableOfContents",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "title": "toc_title",
                      "sticky": true,
                      "maxDepth": 1,
                      "items": [
                        { "id": "toc_problem",  "label": "toc_row_problem",  "anchor": "section_problem",  "level": 1 },
                        { "id": "toc_docs",     "label": "toc_row_docs",     "anchor": "section_docs",     "level": 1 },
                        { "id": "toc_compared", "label": "toc_row_compared", "anchor": "section_compared", "level": 1 },
                        { "id": "toc_declare",  "label": "toc_row_declare",  "anchor": "section_declare",  "level": 1 },
                        { "id": "toc_run",      "label": "toc_row_run",      "anchor": "section_run",      "level": 1 },
                        { "id": "toc_limits",   "label": "toc_row_limits",   "anchor": "section_limits",   "level": 1 }
                      ],
                      "stickyOffset": 80
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
