{
  "type": "View",
  "id": "concepts_implementation_contract_check_root",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "matchParent",
  "background": "surface_muted",
  "child": [
    {
      "data": [
        { "name": "nextReadLinks", "class": "CollectionDataSource" },
        { "name": "onNavigateConcepts", "class": "() -> Void" }
      ]
    },
    {
      "type": "Scroll",
      "id": "concepts_implementation_contract_check_scroll",
      "width": "matchParent",
      "weight": 1,
      "child": [
        {
          "type": "View",
          "orientation": "vertical",
          "id": "concepts_implementation_contract_check_header",
          "width": "matchParent",
          "height": "wrapContent",
          "paddings": [24, 32, 24, 32],
          "child": [
            {
              "type": "Label",
              "height": "wrapContent",
              "fontSize": 13,
              "fontWeight": "semibold",
              "fontColor": "ink_subtle",
              "tapBackground": "surface_sunken",
              "onClick": "@{onNavigateConcepts}",
              "text": "breadcrumb",
              "width": "wrapContent"
            },
            {
              "type": "Label",
              "width": "matchParent",
              "height": "wrapContent",
              "topMargin": 16,
              "fontSize": 36,
              "fontWeight": "bold",
              "fontColor": "ink",
              "text": "title"
            },
            {
              "type": "Label",
              "width": "matchParent",
              "height": "wrapContent",
              "topMargin": 16,
              "fontSize": 17,
              "fontColor": "ink_muted",
              "text": "lead"
            },
            {
              "type": "Label",
              "width": "matchParent",
              "height": "wrapContent",
              "topMargin": 12,
              "fontSize": 13,
              "fontColor": "ink_subtle",
              "text": "read_time"
            }
          ]
        },
        {
          "type": "View",
          "id": "concepts_implementation_contract_check_content_with_rail",
          "orientation": "horizontal",
          "width": "matchParent",
          "height": "wrapContent",
          "child": [
            {
              "type": "View",
              "id": "concepts_implementation_contract_check_body_column",
              "orientation": "vertical",
              "weight": 1,
              "height": "wrapContent",
              "child": [
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_problem",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "surface_muted",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "ink", "text": "section_problem_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "ink_muted", "text": "section_problem_body" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_split",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "surface_base",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "ink", "text": "section_split_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "ink_muted", "text": "section_split_body" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_confidence",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "surface_muted",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "ink", "text": "section_confidence_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "ink_muted", "text": "section_confidence_body" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_plugin_tiers",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "surface_base",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "ink", "text": "section_plugin_tiers_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "ink_muted", "text": "section_plugin_tiers_body" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_reading",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "surface_muted",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "ink", "text": "section_reading_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "ink_muted", "text": "section_reading_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "ink_muted", "text": "section_reading_summary" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "code": "# four operations in docs/api, nothing excluded\n  ✓ ok  ok=4 mismatch=0 missing_in_impl=0 missing_in_doc=0 skipped=0  [4/4 operation]\n\n# ignore_paths: [\"/internal/*\"]\n  ✓ ok  ok=3 mismatch=0 ... skipped=0  [3/4 operation, 1 excluded by config]\n\n# ignore_paths: [\"/api/*\", \"/internal/*\"] — every count is zero, and so is the exit code\n  ✓ ok  ok=0 mismatch=0 ... skipped=0  [0/4 operation, 4 excluded by config]\n    (warning) 4 operation(s) are declared in docs/api but NONE were compared —\n              every one was excluded by configuration. This is not 'the contract\n              matches'; nothing was checked.",
                      "language": "text",
                      "filename": "jsonui-doc check — the same green, three different amounts of checking",
                      "showLineNumbers": false,
                      "copyable": false
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_limits",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "surface_base",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "ink", "text": "section_limits_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "ink_muted", "text": "section_limits_body" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "concepts_implementation_contract_check_next",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [32, 32, 32, 32],
                  "background": "chrome_fill",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 24, "fontWeight": "bold", "fontColor": "chrome_ink", "text": "next_heading" },
                    {
                      "type": "Collection",
                      "id": "concepts_implementation_contract_check_next_collection",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 20,
                      "columnCount": 2,
                      "lineSpacing": 16,
                      "itemSpacing": 16,
                      "lazy": "none",
                      "scrollEnabled": false,
                      "items": "@{nextReadLinks}",
                      "cellIdProperty": "id",
                      "sections": [ { "cell": "cells/next_step_card" } ]
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "concepts_implementation_contract_check_footer",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 32, 32],
                  "background": "chrome_fill",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 12, "fontColor": "ink_faint", "text": "footer_copyright" }
                  ]
                }
              ]
            },
            {
              "type": "View",
              "id": "concepts_implementation_contract_check_rail_column",
              "orientation": "vertical",
              "width": 260,
              "height": "wrapContent",
              "paddings": [24, 16, 24, 16],
              "child": [
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "concepts_implementation_contract_check_toc_wrap",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 0, 32],
                  "background": "surface_muted",
                  "child": [
                    {
                      "type": "TableOfContents",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "title": "toc_title",
                      "sticky": true,
                      "maxDepth": 1,
                      "items": [
                        { "id": "toc_problem",       "label": "toc_row_problem",       "anchor": "section_problem",       "level": 1 },
                        { "id": "toc_split",         "label": "toc_row_split",         "anchor": "section_split",         "level": 1 },
                        { "id": "toc_confidence",    "label": "toc_row_confidence",    "anchor": "section_confidence",    "level": 1 },
                        { "id": "toc_plugin_tiers",  "label": "toc_row_plugin_tiers",  "anchor": "section_plugin_tiers",  "level": 1 },
                        { "id": "toc_reading",       "label": "toc_row_reading",       "anchor": "section_reading",       "level": 1 },
                        { "id": "toc_limits",        "label": "toc_row_limits",        "anchor": "section_limits",        "level": 1 }
                      ],
                      "stickyOffset": 80
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
