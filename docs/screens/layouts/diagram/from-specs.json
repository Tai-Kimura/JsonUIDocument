                    {
                      "type": "CodeBlock", "width": "matchParent", "height": "wrapContent", "topMargin": 12,
                      "code": "\"transitions\": [\n  { \"condition\": \"tap a row\",             \"destination\": \"ItemDetail\" },\n  { \"condition\": \"tap 'Terms of use'\",    \"destination\": \"External Browser\" },\n  { \"condition\": \"switch the filter tab\", \"destination\": \"遷移なし（タブ切替）\" },\n  { \"condition\": \"tap 'Close'\",           \"destination\": \"dismiss\" },\n  { \"condition\": \"tap 'Help'\",            \"destination\": \"/help\" }\n]",
                      "language": "json",
                      "filename": "ItemListScreen.spec.json — five kinds in one column: screen, external, none, back, route",
                      "showLineNumbers": false,
                      "copyable": true
                    }
                  ]
                },
                {
                  "type": "View", "orientation": "vertical", "id": "section_resolve", "width": "matchParent", "height": "wrapContent", "paddings": [24, 32, 24, 32], "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_resolve_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_resolve_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_resolve_multiple" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_resolve_when" }
                  ]
                },
                {
                  "type": "View", "orientation": "vertical", "id": "section_declare", "width": "matchParent", "height": "wrapContent", "paddings": [24, 32, 24, 32], "background": "#FFFFFF",
