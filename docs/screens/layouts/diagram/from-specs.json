{
  "type": "View",
  "id": "diagram_from_specs_root",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "matchParent",
  "background": "#F9FAFB",
  "child": [
    {
      "data": [
        { "name": "nextReadLinks", "class": "CollectionDataSource" },
        { "name": "onNavigateDiagram", "class": "() -> Void" }
      ]
    },
    {
      "type": "Scroll",
      "id": "diagram_from_specs_scroll",
      "width": "matchParent",
      "weight": 1,
      "child": [
        {
          "type": "View",
          "orientation": "vertical",
          "id": "diagram_from_specs_header",
          "width": "matchParent",
          "height": "wrapContent",
          "paddings": [24, 32, 24, 32],
          "child": [
            { "type": "Label", "height": "wrapContent", "width": "wrapContent", "fontSize": 13, "fontWeight": "semibold", "fontColor": "#64748B", "tapBackground": "#F3F4F6", "onClick": "@{onNavigateDiagram}", "text": "breadcrumb" },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 36, "fontWeight": "bold", "fontColor": "#0B1220", "text": "title" },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 17, "fontColor": "#475467", "text": "lead" },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 13, "fontColor": "#64748B", "text": "read_time" }
          ]
        },
        {
          "type": "View",
          "id": "diagram_from_specs_content_with_rail",
          "orientation": "horizontal",
          "width": "matchParent",
          "height": "wrapContent",
          "child": [
            {
              "type": "View",
              "id": "diagram_from_specs_body_column",
              "orientation": "vertical",
              "weight": 1,
              "height": "wrapContent",
              "child": [
                {
                  "type": "View", "orientation": "vertical", "id": "section_source", "width": "matchParent", "height": "wrapContent", "paddings": [24, 32, 24, 32], "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_source_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_source_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_source_rule" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_source_why" }
                  ]
                },
                {
                  "type": "View", "orientation": "vertical", "id": "section_kinds", "width": "matchParent", "height": "wrapContent", "paddings": [24, 32, 24, 32], "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_kinds_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_kinds_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_kinds_bullet_screen" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 8, "fontSize": 14, "fontColor": "#475467", "text": "section_kinds_bullet_route" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 8, "fontSize": 14, "fontColor": "#475467", "text": "section_kinds_bullet_external" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 8, "fontSize": 14, "fontColor": "#475467", "text": "section_kinds_bullet_none" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 8, "fontSize": 14, "fontColor": "#475467", "text": "section_kinds_bullet_back" },
