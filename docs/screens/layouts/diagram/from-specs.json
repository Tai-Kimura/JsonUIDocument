                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_declare_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_declare_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_declare_appowned" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_declare_scope" },
                    {
                      "type": "CodeBlock", "width": "matchParent", "height": "wrapContent", "topMargin": 12,
                      "code": "{\n  \"spec\": {\n    \"transitionAliases\": [\n      { \"position\": \"prefix\", \"affix\": \"Web\" },\n      { \"position\": \"suffix\", \"affix\": \"画面\" },\n      { \"position\": \"suffix\", \"affix\": \"View\" }\n    ]\n  },\n  \"test\": {\n    \"appOwnedScreens\": [\n      \"splash\",\n      { \"id\": \"account_chooser\", \"group\": \"entry\",\n        \"transitions\": [\n          { \"condition\": \"an account is picked\", \"destination\": \"Home\" },\n          { \"condition\": \"tap 'Cancel'\",         \"destination\": \"back\" }\n        ] }\n    ]\n  }\n}",
                      "language": "json",
                      "filename": "jui.config.json — the two declaration points; a bare id and the object form side by side",
                      "showLineNumbers": false,
                      "copyable": true
                    }
                  ]
                },
                {
                  "type": "View", "orientation": "vertical", "id": "section_check", "width": "matchParent", "height": "wrapContent", "paddings": [24, 32, 24, 32], "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_check_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_check_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_check_exempt" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_check_report" },
                    {
                      "type": "CodeBlock", "width": "matchParent", "height": "wrapContent", "topMargin": 12,
                      "code": "  ERROR [doc-diagram]: MyApp: flow test \"checkout\" (flows/checkout.test.json) transitions item_detail -> cart: item_detail's spec declares no transition to cart; 1 of its destination(s) could not be resolved and count as absent: 'Basket'\n  ERROR [doc-diagram]: MyApp: flow test \"first_run\" (flows/first_run.test.json) transitions splash -> home: the app-owned screen splash declares no transition to home (jui.config.json test.appOwnedScreens[].transitions)",
                      "language": "text",
                      "filename": "generate html — the line shape, with illustrative values: two of the three reasons, the first naming the likely fix",
                      "showLineNumbers": false,
                      "copyable": true
                    }
                  ]
                },
                {
                  "type": "View", "orientation": "vertical", "id": "section_absent", "width": "matchParent", "height": "wrapContent", "paddings": [24, 32, 24, 32], "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_absent_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_absent_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_absent_none" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_absent_perface" }
                  ]
                },
                {
                  "type": "View", "orientation": "vertical", "id": "section_page", "width": "matchParent", "height": "wrapContent", "paddings": [24, 32, 24, 32], "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_page_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_page_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_page_ungrouped" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_page_closing" },
                    {
                      "type": "CodeBlock", "width": "matchParent", "height": "wrapContent", "topMargin": 12,
                      "code": "    diagram MyApp: specs 11 / transitions 24 / spec edges 21 (all in the All tab) / none inferred from wording 1 / flow tests 14 in tests/flows (declared test root) checked 14 transition(s), absent 0\nGenerated 63 HTML files (screens 11 / flows 14 / unitContracts not read / warnings 1)",
                      "language": "text",
                      "filename": "generate html — the per-owner diagram line and the closing line; shapes from the shipped source, values illustrative",
                      "showLineNumbers": false,
                      "copyable": true
                    }
                  ]
                },
                {
                  "type": "View", "orientation": "vertical", "id": "section_limits", "width": "matchParent", "height": "wrapContent", "paddings": [24, 32, 24, 32], "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_limits_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_limits_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_limits_vocab" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_limits_pip" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_limits_floor" }
                  ]
                },
                {
                  "type": "View", "orientation": "vertical", "id": "diagram_from_specs_next", "width": "matchParent", "height": "wrapContent", "paddings": [32, 32, 32, 32], "background": "chrome_fill",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 24, "fontWeight": "bold", "fontColor": "chrome_ink", "text": "next_heading" },
                    { "type": "Collection", "id": "diagram_from_specs_next_collection", "width": "matchParent", "height": "wrapContent", "topMargin": 20, "columnCount": 3, "lineSpacing": 16, "itemSpacing": 16, "lazy": "none", "scrollEnabled": false, "items": "@{nextReadLinks}", "cellIdProperty": "id", "sections": [ { "cell": "cells/next_step_card" } ] }
                  ]
                },
                {
                  "type": "View", "orientation": "vertical", "id": "diagram_from_specs_footer", "width": "matchParent", "height": "wrapContent", "paddings": [24, 32, 32, 32], "background": "chrome_fill",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 12, "fontColor": "#94A3B8", "text": "footer_copyright" }
                  ]
                }
              ]
            },
            {
              "type": "View",
              "id": "diagram_from_specs_rail_column",
              "orientation": "vertical",
              "width": 260,
              "height": "wrapContent",
              "paddings": [24, 16, 24, 16],
              "child": [
                {
                  "type": "View", "orientation": "vertical", "id": "diagram_from_specs_toc_wrap", "width": "matchParent", "height": "wrapContent", "paddings": [24, 32, 0, 32], "background": "#F9FAFB",
                  "child": [
                    {
                      "type": "TableOfContents", "width": "matchParent", "height": "wrapContent", "title": "toc_title", "sticky": true, "maxDepth": 1,
                      "items": [
                        { "id": "toc_source",  "label": "toc_row_source",  "anchor": "section_source",  "level": 1 },
                        { "id": "toc_kinds",   "label": "toc_row_kinds",   "anchor": "section_kinds",   "level": 1 },
                        { "id": "toc_resolve", "label": "toc_row_resolve", "anchor": "section_resolve", "level": 1 },
                        { "id": "toc_declare", "label": "toc_row_declare", "anchor": "section_declare", "level": 1 },
                        { "id": "toc_check",   "label": "toc_row_check",   "anchor": "section_check",   "level": 1 },
                        { "id": "toc_absent",  "label": "toc_row_absent",  "anchor": "section_absent",  "level": 1 },
                        { "id": "toc_page",    "label": "toc_row_page",    "anchor": "section_page",    "level": 1 },
                        { "id": "toc_limits",  "label": "toc_row_limits",  "anchor": "section_limits",  "level": 1 }
                      ]
                    }
                  ]
                }
