{
  "type": "View",
  "id": "guides_api_mock_root",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "matchParent",
  "background": "#F9FAFB",
  "child": [
    {
      "data": [
        {
          "name": "nextReadLinks",
          "class": "CollectionDataSource"
        },
        {
          "name": "onNavigateGuides",
          "class": "() -> Void"
        }
      ]
    },
    {
      "type": "Scroll",
      "id": "guides_api_mock_scroll",
      "width": "matchParent",
      "weight": 1,
      "child": [
        {
          "type": "View",
          "orientation": "vertical",
          "id": "guides_api_mock_header",
          "width": "matchParent",
          "height": "wrapContent",
          "paddings": [24, 32, 24, 32],
          "child": [
            {
              "type": "Label",
              "height": "wrapContent",
              "width": "wrapContent",
              "fontSize": 13,
              "fontWeight": "semibold",
              "fontColor": "#64748B",
              "tapBackground": "#F3F4F6",
              "onClick": "@{onNavigateGuides}",
              "text": "breadcrumb"
            },
            {
              "type": "Label",
              "width": "matchParent",
              "height": "wrapContent",
              "topMargin": 16,
              "fontSize": 36,
              "fontWeight": "bold",
              "fontColor": "#0B1220",
              "text": "title"
            },
            {
              "type": "Label",
              "width": "matchParent",
              "height": "wrapContent",
              "topMargin": 16,
              "fontSize": 17,
              "fontColor": "#475467",
              "text": "lead"
            },
            {
              "type": "Label",
              "width": "matchParent",
              "height": "wrapContent",
              "topMargin": 12,
              "fontSize": 13,
              "fontColor": "#64748B",
              "text": "read_time"
            }
          ]
        },
        {
          "type": "View",
          "id": "guides_api_mock_content_with_rail",
          "orientation": "horizontal",
          "width": "matchParent",
          "height": "wrapContent",
          "child": [
            {
              "type": "View",
              "id": "guides_api_mock_body_column",
              "orientation": "vertical",
              "weight": 1,
              "height": "wrapContent",
              "child": [
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_what",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_what_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_what_body" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_files",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_files_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_files_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_files_caption" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "// tests/mocks/listProducts.mock.json  (one file per operationId)\n{\n  \"operationId\": \"listProducts\",\n  \"method\": \"GET\",\n  \"activeScenario\": \"default\",\n  \"scenarios\": {\n    \"default\": { \"status\": 200, \"body\": { \"items\": [{ \"id\": 1, \"name\": \"Sample\" }] } },\n    \"empty\":   { \"status\": 200, \"body\": { \"items\": [] } },\n    \"error\":   { \"status\": 500, \"body\": { \"message\": \"boom\" }, \"delayMs\": 200 }\n  }\n}",
                      "language": "json",
                      "filename": "listProducts.mock.json",
                      "showLineNumbers": false,
                      "copyable": true
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_generate",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_generate_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_generate_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_generate_bullet_check" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_serve",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_serve_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_serve_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_serve_bullet_harden" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_serve_bullet_cli_only" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_scenarios",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_scenarios_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_scenarios_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_scenarios_caption" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "// switch scenarios from a screen test\n{\n  \"type\": \"screen\",\n  \"source\": { \"layout\": \"layouts/home.json\" },\n  \"mocks\": { \"listProducts\": \"empty\" },\n  \"cases\": [{\n    \"name\": \"reload surfaces the error state\",\n    \"steps\": [\n      { \"setMocks\": { \"listProducts\": \"error\" } },\n      { \"tap\": \"reload_btn\" },\n      { \"assert\": \"visible\", \"id\": \"error_banner\" }\n    ]\n  }]\n}",
                      "language": "json",
                      "filename": "scenario-switch.test.json",
                      "showLineNumbers": false,
                      "copyable": true
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_drivers",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_drivers_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_drivers_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_drivers_bullet_admin" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "guides_api_mock_next",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [32, 32, 32, 32],
                  "background": "chrome_fill",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 24, "fontWeight": "bold", "fontColor": "chrome_ink", "text": "next_heading" },
                    {
                      "type": "Collection",
                      "id": "guides_api_mock_next_collection",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 20,
                      "columnCount": 2,
                      "lineSpacing": 16,
                      "itemSpacing": 16,
                      "lazy": "none",
                      "scrollEnabled": false,
                      "items": "@{nextReadLinks}",
                      "cellIdProperty": "id",
                      "sections": [
                        { "cell": "cells/next_step_card" }
                      ]
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "guides_api_mock_footer",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 32, 32],
                  "background": "chrome_fill",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 12, "fontColor": "#94A3B8", "text": "footer_copyright" }
                  ]
                }
              ]
            },
            {
              "type": "View",
              "id": "guides_api_mock_rail_column",
              "orientation": "vertical",
              "width": 260,
              "height": "wrapContent",
              "paddings": [24, 16, 24, 16],
              "child": [
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "guides_api_mock_toc_wrap",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 0, 32],
                  "background": "#F9FAFB",
                  "child": [
                    {
                      "type": "TableOfContents",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "title": "toc_title",
                      "sticky": true,
                      "maxDepth": 1,
                      "items": [
                        { "id": "toc_what", "label": "toc_row_what", "anchor": "section_what", "level": 1 },
                        { "id": "toc_files", "label": "toc_row_files", "anchor": "section_files", "level": 1 },
                        { "id": "toc_generate", "label": "toc_row_generate", "anchor": "section_generate", "level": 1 },
                        { "id": "toc_serve", "label": "toc_row_serve", "anchor": "section_serve", "level": 1 },
                        { "id": "toc_scenarios", "label": "toc_row_scenarios", "anchor": "section_scenarios", "level": 1 },
                        { "id": "toc_drivers", "label": "toc_row_drivers", "anchor": "section_drivers", "level": 1 }
                      ],
                      "stickyOffset": 80
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
