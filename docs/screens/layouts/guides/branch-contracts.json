{
  "type": "View",
  "id": "guides_branch_contracts_root",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "matchParent",
  "background": "#F9FAFB",
  "child": [
    {
      "data": [
        { "name": "nextReadLinks", "class": "CollectionDataSource" },
        { "name": "onNavigateGuides", "class": "() -> Void" }
      ]
    },
    {
      "type": "Scroll",
      "id": "guides_branch_contracts_scroll",
      "width": "matchParent",
      "weight": 1,
      "child": [
        {
          "type": "View",
          "orientation": "vertical",
          "id": "guides_branch_contracts_header",
          "width": "matchParent",
          "height": "wrapContent",
          "paddings": [24, 32, 24, 32],
          "child": [
            {
              "type": "Label",
              "height": "wrapContent",
              "width": "wrapContent",
              "fontSize": 13,
              "fontWeight": "semibold",
              "fontColor": "#64748B",
              "tapBackground": "#F3F4F6",
              "onClick": "@{onNavigateGuides}",
              "text": "breadcrumb"
            },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 36, "fontWeight": "bold", "fontColor": "#0B1220", "text": "title" },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 17, "fontColor": "#475467", "text": "lead" },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 13, "fontColor": "#64748B", "text": "read_time" }
          ]
        },
        {
          "type": "View",
          "id": "guides_branch_contracts_content_with_rail",
          "orientation": "horizontal",
          "width": "matchParent",
          "height": "wrapContent",
          "child": [
            {
              "type": "View",
              "id": "guides_branch_contracts_body_column",
              "orientation": "vertical",
              "weight": 1,
              "height": "wrapContent",
              "child": [
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_what",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_what_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_what_body" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_example",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_example_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_example_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "\"branchContracts\": {\n  \"conditions\": {\n    \"formValid\": {\n      \"meaning\": \"every required field is filled\",\n      \"witness_true\":  { \"form\": { \"nickname\": \"a\" } },\n      \"witness_false\": { \"form\": { \"nickname\": \"\" } }\n    }\n  },\n  \"methods\": {\n    \"onTapSave\": {\n      \"baseline\": { \"isSaving\": false },\n      \"branches\": [\n        { \"when\": { \"cond\": \"!formValid\" },\n          \"then\": { \"data.errorMessage\": \"@profile_screen_invalid\", \"api\": \"none\" } },\n        { \"when\": { \"cond\": \"formValid\", \"api.updateProfile\": \"success\" },\n          \"then\": { \"transition\": \"HomeScreen\",\n                    \"api.updateProfile.request\": { \"nickname\": \"@data.form\" } } },\n        { \"when\": { \"cond\": \"formValid\", \"api.updateProfile\": \"failure\" },\n          \"then\": { \"data.errorMessage\": \"@profile_screen_failed\",\n                    \"api.updateProfile\": \"called\" } },\n        { \"note\": \"double-tap guard: second tap while isSaving is dropped\" }\n      ]\n    }\n  }\n}",
                      "language": "json",
                      "filename": "ProfileScreen.spec.json — branchContracts",
                      "showLineNumbers": false,
                      "copyable": true
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_conditions",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_conditions_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_conditions_body" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_when",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_when_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_when_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "key           | value                          | means\n--------------+--------------------------------+-------------------------------------------------\ndata.<field>  | literal                        | the declared data field holds this value\narg.<name>    | literal                        | the method argument holds this value\napi.<op>      | named mock scenario            | the API operation answers with this scenario\ncond          | condition name ('!' prefix ok) | a named condition from branchContracts.conditions",
                      "language": "text",
                      "filename": "when keys",
                      "showLineNumbers": false,
                      "copyable": false
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_then",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_then_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_then_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "key              | value                                    | asserts\n-----------------+------------------------------------------+--------------------------------------------\ndata.<field>     | literal / \"@strings_key\" / \"@data.<field>\" | the field ends up holding this value\ntransition       | destination name                         | the screen navigates there\napi              | \"none\"                                   | no API operation is called at all\napi.<op>         | \"called\" or \"not-called\"                 | whether that operation fires\napi.<op>.request | partial object                           | the request body contains these entries",
                      "language": "text",
                      "filename": "then keys",
                      "showLineNumbers": false,
                      "copyable": false
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_validate",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_validate_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_validate_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 14, "fontColor": "#475467", "text": "section_validate_bullet_error" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_validate_bullet_warning" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_validate_bullet_promote" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_validate_bullet_skip" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "[ERROR] ...when.flag.debug: Unknown when key 'flag.debug' — allowed: 'data.<field>',\n        'arg.<name>', 'api.<op>', 'cond'\n[ERROR] ...when.cond: cond references undeclared condition 'ghostCondition' — declare it\n        in branchContracts.conditions\n[ERROR] ...branches[3]: A note branch must contain only 'note' (found ['when']). Declare\n        the contract half as a separate {when, then} branch.\n[ERROR] branchContracts.methods.ghostMethod: Method 'ghostMethod' not found in\n        dataFlow.viewModel.methods or stateManagement.eventHandlers\n[WARNING] ...then.data.typoField: Data field 'typoField' is not declared in\n        stateManagement.uiVariables / dataFlow.viewModel.vars / stateManagement.states\n[WARNING] ...when.api.deleteProfile: API operation 'deleteProfile' is not declared in\n        dataFlow.repositories[].methods or dataFlow.useCases[].methods\n[WARNING] ...then.transition: Transition destination 'GhostScreen' does not match any\n        transitions[].destination",
                      "language": "text",
                      "filename": "jsonui-doc validate spec — findings",
                      "showLineNumbers": false,
                      "copyable": false
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_render",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_render_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_render_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "Branch Contracts\n1 method(s) — 3 declared branch(es), 1 note-only branch(es) outside the\nmachine-checkable contract.\n\nNamed Conditions\n  Name      | Meaning                        | Witness (true)          | Witness (false)\n  formValid | every required field is filled | form = {\"nickname\":\"a\"} | form = {\"nickname\":\"\"}\n\nonTapSave — Baseline: isSaving = false\n  # | When                                              | Then\n  1 | cond = \"!formValid\"                               | data.errorMessage = \"@profile_screen_invalid\", api = \"none\"\n  2 | cond = \"formValid\", api.updateProfile = \"success\" | transition = \"HomeScreen\", api.updateProfile.request = {...}\n  3 | cond = \"formValid\", api.updateProfile = \"failure\" | data.errorMessage = \"@profile_screen_failed\", api.updateProfile = \"called\"\n  4 | note (not machine-checked): double-tap guard: second tap while isSaving is dropped",
                      "language": "text",
                      "filename": "generated HTML — decision table (as text)",
                      "showLineNumbers": false,
                      "copyable": false
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_tests",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_tests_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_tests_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "$ jsonui-test generate branch-tests profile_screen\nGenerated branch tests for 'profile_screen':\n  tests/unit/generated/profile_screen.branches.test.ts  (3 declared branch(es), 1 note-only listed as comments)\n  tests/unit/generated/jsonui-branch-runtime.ts  (shared runtime)\n  tests/unit/branch-harness/profile_screen.ts  (NEW harness skeleton — implement createHarness())\n  routes: updateProfile",
                      "language": "bash",
                      "filename": "generate branch-tests — output",
                      "showLineNumbers": false,
                      "copyable": true
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 14, "fontColor": "#475467", "text": "section_tests_bullet_mock" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_tests_bullet_harness" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "it(\"branch 2: cond=\\\"formValid\\\" & api.updateProfile=\\\"success\\\"\", async () => {\n  const h = createHarness();\n  h.setState({\"isSaving\": false, \"form\": {\"nickname\": \"a\"}});\n  const rec = installFetchMock(ROUTES, {\"updateProfile\": \"success\"});\n  const ref_form = h.readField(\"form\");\n  try {\n    await (h.vm as any).onTapSave();\n    await settle();\n    h.expectTransition(\"HomeScreen\");\n    expect(rec.countFor(\"updateProfile\")).toBeGreaterThan(0);\n    expect(partialMismatches(rec.lastBodyFor(\"updateProfile\"), { \"nickname\": ref_form })).toEqual([]);\n  } finally {\n    rec.restore();\n  }\n});",
                      "language": "typescript",
                      "filename": "profile_screen.branches.test.ts — branch 2 (@generated)",
                      "showLineNumbers": false,
                      "copyable": false
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 14, "fontColor": "#475467", "text": "section_tests_bullet_binding" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "Error: branches[1].when.api.updateProfile: api operation 'updateProfile' has no `endpoint`\n       declaration in dataFlow.repositories/useCases — declare the method with its\n       endpoint (e.g. \"endpoint\": \"POST /api/...\")\nError: branches[1].when.api.updateProfile: no mock file found for PUT /api/items\n       (op 'updateProfile') under the mocks directory\nError: branches[1].when.api.updateProfile: scenario 'timeout' not found in\n       ['failure', 'success'] (mock for PUT /api/items)\nError: condition 'formValid' has no witness_false — test generation needs a witness\n       to arrange the state",
                      "language": "text",
                      "filename": "hard generation errors — one seeded mistake each",
                      "showLineNumbers": false,
                      "copyable": false
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_android",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_android_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_android_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "$ jsonui-test generate branch-tests profile_screen \\\n    --platform android --package com.example.profile \\\n    --out-dir app/src/test/java --harness-dir app/src/test/java\nGenerated branch tests for 'profile_screen':\n  app/src/test/java/com/example/profile/ProfileScreenBranchesTest.kt  (3 declared branch(es), 1 note-only listed as comments)\n  app/src/test/java/com/example/profile/JsonuiBranchRuntime.kt  (shared runtime)\n  app/src/test/java/com/example/profile/ProfileScreenBranchHarness.kt  (NEW harness skeleton — implement createHarness())\n  routes: updateProfile",
                      "language": "bash",
                      "filename": "generate branch-tests --platform android — output",
                      "showLineNumbers": false,
                      "copyable": true
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 14, "fontColor": "#475467", "text": "section_android_bullet_design" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_android_bullet_prereqs" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "// branch 2: cond=\"formValid\" & api.updateProfile=\"success\"\n@Test fun `onTapSave branch 2`() {\n  runBranchTest(routes, mapOf<String, Any?>(\"updateProfile\" to \"success\"), ::createProfileScreenBranchHarness) { h, rec ->\n    h.setState(mapOf<String, Any?>(\"isSaving\" to false, \"form\" to mapOf<String, Any?>(\"nickname\" to \"a\")))\n    val ref_form = h.readField(\"form\")\n    h.invoke(\"onTapSave\")\n    h.settle()\n    h.expectTransition(\"HomeScreen\")\n    assertTrue(rec.countFor(\"updateProfile\") > 0)\n    assertEquals(emptyList<String>(), partialMismatches(rec.lastBodyFor(\"updateProfile\"), mapOf<String, Any?>(\"nickname\" to Ref(ref_form))))\n  }\n}",
                      "language": "kotlin",
                      "filename": "ProfileScreenBranchesTest.kt — branch 2 (@generated)",
                      "showLineNumbers": false,
                      "copyable": false
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "guides_branch_contracts_next",
