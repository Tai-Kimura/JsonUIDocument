                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "fontSize": 16,
                      "fontColor": "#475467",
                      "text": "section_browser_body"
                    },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 8,
                      "code": "root   app default         none     false   true     max 1.5   2.5.35\n16px   (not set)           13px     13px    13px     13px      13px\n32px   (not set)           26px     13px    26px     19.5px    26px\n32px   scaling: false      13px     13px    26px     13px      26px\n32px   maxScale: 1.5       19.5px   13px    19.5px   19.5px    26px",
                      "language": "text",
                      "filename": "computed font-size, headless Chromium",
                      "showLineNumbers": false,
                      "copyable": false
                    },
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "fontSize": 14,
                      "fontColor": "#475467",
                      "text": "section_browser_bullet_same"
