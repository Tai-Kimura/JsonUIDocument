{
  "type": "View",
  "id": "guides_text_size_root",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "matchParent",
  "background": "#F9FAFB",
  "child": [
    {
      "data": [
        {
          "name": "nextReadLinks",
          "class": "CollectionDataSource"
        },
        {
          "name": "onNavigateGuides",
          "class": "() -> Void"
        }
      ]
    },
    {
      "type": "Scroll",
      "id": "guides_text_size_scroll",
      "width": "matchParent",
      "weight": 1,
      "child": [
        {
          "type": "View",
          "orientation": "vertical",
          "id": "guides_text_size_header",
          "width": "matchParent",
          "height": "wrapContent",
          "paddings": [
            24,
            32,
            24,
            32
          ],
          "child": [
            {
              "type": "Label",
              "height": "wrapContent",
              "width": "wrapContent",
              "fontSize": 13,
              "fontWeight": "semibold",
              "fontColor": "#64748B",
              "tapBackground": "#F3F4F6",
              "onClick": "@{onNavigateGuides}",
              "text": "breadcrumb"
            },
            {
              "type": "Label",
              "width": "matchParent",
              "height": "wrapContent",
              "topMargin": 16,
              "fontSize": 36,
              "fontWeight": "bold",
              "fontColor": "#0B1220",
              "text": "title"
            },
            {
              "type": "Label",
              "width": "matchParent",
              "height": "wrapContent",
              "topMargin": 16,
              "fontSize": 17,
              "fontColor": "#475467",
              "text": "lead"
            },
            {
              "type": "Label",
              "width": "matchParent",
              "height": "wrapContent",
              "topMargin": 12,
              "fontSize": 13,
              "fontColor": "#64748B",
              "text": "read_time"
            }
          ]
        },
        {
          "type": "View",
          "id": "guides_text_size_content_with_rail",
          "orientation": "horizontal",
          "width": "matchParent",
          "height": "wrapContent",
          "child": [
            {
              "type": "View",
              "id": "guides_text_size_body_column",
              "orientation": "vertical",
              "weight": 1,
              "height": "wrapContent",
              "child": [
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_what",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [
                    24,
                    32,
                    24,
                    32
                  ],
                  "background": "#FFFFFF",
                  "child": [
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "fontSize": 26,
                      "fontColor": "#0B1220",
                      "text": "section_what_heading",
                      "fontWeight": "bold"
                    },
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "fontSize": 16,
                      "fontColor": "#475467",
                      "text": "section_what_body"
                    },
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "fontSize": 13,
                      "fontColor": "#64748B",
                      "text": "section_what_caption"
                    },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 8,
                      "code": "{\n  \"type\": \"View\",\n  \"orientation\": \"vertical\",\n  \"child\": [\n    { \"type\": \"Label\", \"id\": \"price\", \"text\": \"@{price}\", \"fontSize\": 28, \"maxFontScale\": 1.5 },\n    { \"type\": \"Label\", \"id\": \"badge\", \"text\": \"NEW\", \"fontSize\": 11, \"fontScaling\": false },\n    { \"type\": \"Label\", \"id\": \"note\", \"text\": \"@{note}\", \"fontSize\": 15 }\n  ]\n}",
                      "language": "json",
                      "filename": "layout",
                      "showLineNumbers": false,
                      "copyable": true
                    },
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "fontSize": 14,
                      "fontColor": "#475467",
                      "text": "section_what_bullet_nosize"
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_generated",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [
                    24,
                    32,
                    24,
                    32
                  ],
                  "background": "#F9FAFB",
                  "child": [
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "fontSize": 26,
                      "fontColor": "#0B1220",
                      "text": "section_generated_heading",
                      "fontWeight": "bold"
                    },
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "fontSize": 16,
                      "fontColor": "#475467",
                      "text": "section_generated_body"
                    },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 8,
                      "code": "Label, fontSize 13 — jsonui-cli 2.5.36\n\nWeb (the size class on the element)\n  no declaration       text-[length:min(calc(13*var(--jui-font-unit,0.0625rem)),calc(13*var(--jui-font-max,10000px)))]\n  fontScaling: false   text-[length:13px]\n  fontScaling: true    text-[length:min(0.8125rem,calc(13*var(--jui-font-max,10000px)))]\n  maxFontScale: 1.5    text-[length:min(calc(13*var(--jui-font-unit,0.0625rem)),19.5px)]\n\niOS (SwiftUI)\n  no declaration       (nothing added)\n  fontScaling: false   .fontScaling(false, maxFontScale: nil)\n  maxFontScale: 1.5    .fontScaling(nil, maxFontScale: CGFloat(1.5))\n\nAndroid (Compose)\n  no declaration       fontSize = jsonUIFontSize(…)\n  fontScaling: false   fontSize = jsonUIFontSize(…, fontScaling = false)\n  maxFontScale: 1.5    fontSize = jsonUIFontSize(…, maxFontScale = 1.5f)\n\n2.5.35 wrote text-[0.8125rem], fontSize: 13 and 13.sp for all four, with no declaration.",
                      "language": "text",
                      "filename": "generated (excerpts)",
                      "showLineNumbers": false,
                      "copyable": false
                    },
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "fontSize": 14,
                      "fontColor": "#475467",
                      "text": "section_generated_bullet_web"
                    },
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "fontSize": 14,
                      "fontColor": "#475467",
                      "text": "section_generated_bullet_ios"
                    },
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "fontSize": 14,
                      "fontColor": "#475467",
                      "text": "section_generated_bullet_android"
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_defaults",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [
                    24,
                    32,
                    24,
                    32
                  ],
                  "background": "#FFFFFF",
                  "child": [
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "fontSize": 26,
                      "fontColor": "#0B1220",
                      "text": "section_defaults_heading",
                      "fontWeight": "bold"
                    },
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "fontSize": 16,
                      "fontColor": "#475467",
                      "text": "section_defaults_body"
                    },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 8,
                      "code": "// iOS (SwiftJsonUI 10.37.0)\nSwiftJsonUIConfiguration.shared.font.maxScale = 2.0\n// SwiftJsonUIConfiguration.shared.font.scaling = false   // stop following\n\n// Android (KotlinJsonUI 2.56.0)\nConfiguration.Font.maxScale = 2.0f\n// Configuration.Font.scaling = false\n\n// Web (the Configuration template, src/lib/jsonui/Configuration.ts by default)\nConfiguration.Font.configureScaling({ maxScale: 2 })\n// Configuration.Font.configureScaling({ scaling: false })",
                      "language": "text",
                      "filename": "app defaults",
                      "showLineNumbers": false,
                      "copyable": false
                    },
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "fontSize": 14,
                      "fontColor": "#475467",
                      "text": "section_defaults_bullet_web"
                    },
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "fontSize": 14,
                      "fontColor": "#475467",
                      "text": "section_defaults_bullet_provider"
                    },
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 16,
                      "fontSize": 14,
                      "fontColor": "#475467",
                      "text": "section_defaults_bullet_nosize"
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_browser",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [
                    24,
                    32,
                    24,
                    32
                  ],
                  "background": "#F9FAFB",
                  "child": [
                    {
                      "type": "Label",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "fontSize": 26,
                      "fontColor": "#0B1220",
                      "text": "section_browser_heading",
                      "fontWeight": "bold"
