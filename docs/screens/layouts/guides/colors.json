{
  "type": "View",
  "id": "guides_colors_root",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "matchParent",
  "background": "#F9FAFB",
  "child": [
    {
      "data": [
        { "name": "nextReadLinks", "class": "CollectionDataSource" },
        { "name": "onNavigateGuides", "class": "() -> Void" },
        { "name": "onNavigateLocalization", "class": "() -> Void" },
        { "name": "onNavigateAttributesStyle", "class": "() -> Void" }
      ]
    },
    {
      "type": "Scroll",
      "id": "guides_colors_scroll",
      "width": "matchParent",
      "weight": 1,
      "child": [
        {
          "type": "View",
          "orientation": "vertical",
          "id": "guides_colors_header",
          "width": "matchParent",
          "height": "wrapContent",
          "paddings": [24, 32, 24, 32],
          "child": [
            {
              "type": "Label",
              "height": "wrapContent",
              "width": "wrapContent",
              "fontSize": 13,
              "fontWeight": "semibold",
              "fontColor": "#64748B",
              "tapBackground": "#F3F4F6",
              "onClick": "@{onNavigateGuides}",
              "text": "breadcrumb"
            },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 36, "fontWeight": "bold", "fontColor": "#0B1220", "text": "title" },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 17, "fontColor": "#475467", "text": "lead" },
            { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 13, "fontColor": "#64748B", "text": "read_time" }
          ]
        },
        {
          "type": "View",
          "id": "guides_colors_content_with_rail",
          "orientation": "horizontal",
          "width": "matchParent",
          "height": "wrapContent",
          "child": [
            {
              "type": "View",
              "id": "guides_colors_body_column",
              "orientation": "vertical",
              "weight": 1,
              "height": "wrapContent",
              "child": [
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_palette",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_palette_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_palette_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "{\n  \"modes\": [\"light\", \"dark\"],\n  \"fallback_mode\": \"light\",\n  \"systemModeMapping\": { \"light\": \"light\", \"dark\": \"dark\" },\n\n  \"light\": {\n    \"ink\":        \"#0B1220\",\n    \"ink_muted\":  \"#475467\",\n    \"surface\":    \"#FFFFFF\",\n    \"accent\":     \"#2563EB\"\n  },\n  \"dark\": {\n    \"ink\":        \"#F6F5F1\",\n    \"ink_muted\":  \"#D1CFC7\",\n    \"surface\":    \"#16161A\",\n    \"accent\":     \"#D4A574\"\n  }\n}",
                      "language": "json",
                      "filename": "Resources/colors.json",
                      "showLineNumbers": false,
                      "copyable": true
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "partialAttributes": [{"range": "/guides/localization", "fontColor": "accent", "underline": {"lineStyle": "Single"}, "onclick": "onNavigateLocalization"}], "text": "section_palette_note" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_auto",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_auto_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "partialAttributes": [{"range": "/reference/attributes/style", "fontColor": "accent", "underline": {"lineStyle": "Single"}, "onclick": "onNavigateAttributesStyle"}], "text": "section_auto_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "# you write                          # the build distributes\n{ \"background\": \"#123456\" }         { \"background\": \"dark_cyan\" }\n{ \"fontColor\": \"#475467\" }          { \"fontColor\": \"ink_muted\" }\n\n[INFO] Extracting colors from 133 files (0 skipped)...\n[INFO] Replaced colors in 84 files\n[INFO] Updated colors.json with 2 new colors across 1 mode(s)\n[WARN] Color 'dark_cyan' is not defined for every mode in colors.json —\n       Tailwind @theme cannot resolve it (resolving to #123456).",
                      "language": "text",
                      "filename": "jui build",
                      "showLineNumbers": false,
                      "copyable": false
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 14, "fontColor": "#475467", "text": "section_auto_bullet_key" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_auto_bullet_match" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_auto_bullet_where" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_auto_bullet_undefined" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_emits",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_emits_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_emits_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "Platform | Generated from colors.json      | How a screen reads a colour\n---------+---------------------------------+---------------------------------------\niOS      | ColorManager.swift              | ColorManager.color(for: \"accent\")\n         | (ColorMode enum, systemMode-    | -> UIColor?, or the SwiftUI Color\n         |  Mapping keyed by UIUser-       |    accessor for a static name\n         |  InterfaceStyle)                |\nAndroid  | ColorManager.kt                 | ColorManager.compose.color(\"accent\")\n         | (object, currentMode is a       | -> Compose Color; recomposition is\n         |  mutableStateOf)                |    automatic on a mode change\nWeb      | ColorManager.ts + theme.css     | class `bg-accent` for a static name;\n         | (@theme block + per-mode        | ColorManager.resolveColor(x) when the\n         |  :root[data-theme=\"<mode>\"])    | value lands in an inline style",
                      "language": "text",
                      "filename": "per-platform output",
                      "showLineNumbers": false,
                      "copyable": false
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_emits_note" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_runtime",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_runtime_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_runtime_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 14, "fontColor": "#475467", "text": "section_runtime_bullet_system" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_runtime_bullet_manual" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_runtime_bullet_subscribe" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_static_dynamic",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_static_dynamic_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_static_dynamic_body" },
                    {
                      "type": "CodeBlock",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 12,
                      "code": "// static token -> Tailwind class, follows the theme with no JS\n<span className=\"text-ink_muted bg-surface\">…</span>\n\n// bound colour -> inline style, resolved through the palette\nstyle={{ backgroundColor: ColorManager.resolveColor(data.statusBg),\n         color: ColorManager.resolveColor(data.statusFg) }}",
                      "language": "tsx",
                      "filename": "generated web output",
                      "showLineNumbers": false,
                      "copyable": false
                    },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_static_dynamic_note" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_mode_complete",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#F9FAFB",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_mode_complete_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_mode_complete_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 14, "fontColor": "#475467", "text": "section_mode_complete_note" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "section_gotchas",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 24, 32],
                  "background": "#FFFFFF",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 26, "fontWeight": "bold", "fontColor": "#0B1220", "text": "section_gotchas_heading" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 12, "fontSize": 16, "fontColor": "#475467", "text": "section_gotchas_body" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 16, "fontSize": 14, "fontColor": "#475467", "text": "section_gotchas_bullet_promote" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_gotchas_bullet_optin" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_gotchas_bullet_alpha" },
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "topMargin": 6, "fontSize": 14, "fontColor": "#475467", "text": "section_gotchas_bullet_inline" }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "guides_colors_next",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [32, 32, 32, 32],
                  "background": "chrome_fill",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 24, "fontWeight": "bold", "fontColor": "chrome_ink", "text": "next_heading" },
                    {
                      "type": "Collection",
                      "id": "guides_colors_next_collection",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 20,
                      "columnCount": 3,
                      "lineSpacing": 16,
                      "itemSpacing": 16,
                      "lazy": "none",
                      "scrollEnabled": false,
                      "items": "@{nextReadLinks}",
                      "cellIdProperty": "id",
                      "sections": [
                        { "cell": "cells/next_step_card" }
                      ]
                    }
                  ]
                },
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "guides_colors_footer",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 32, 32],
                  "background": "chrome_fill",
                  "child": [
                    { "type": "Label", "width": "matchParent", "height": "wrapContent", "fontSize": 12, "fontColor": "#94A3B8", "text": "footer_copyright" }
                  ]
                }
              ]
            },
            {
              "type": "View",
              "id": "guides_colors_rail_column",
              "orientation": "vertical",
              "width": 260,
              "height": "wrapContent",
              "paddings": [24, 16, 24, 16],
              "child": [
                {
                  "type": "View",
                  "orientation": "vertical",
                  "id": "guides_colors_toc_wrap",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "paddings": [24, 32, 0, 32],
                  "background": "#F9FAFB",
                  "child": [
                    {
                      "type": "TableOfContents",
                      "width": "matchParent",
                      "height": "wrapContent",
                      "title": "toc_title",
                      "sticky": true,
                      "maxDepth": 1,
                      "items": [
                        { "id": "toc_palette", "label": "toc_row_palette", "anchor": "section_palette", "level": 1 },
                        { "id": "toc_auto", "label": "toc_row_auto", "anchor": "section_auto", "level": 1 },
                        { "id": "toc_emits", "label": "toc_row_emits", "anchor": "section_emits", "level": 1 },
                        { "id": "toc_runtime", "label": "toc_row_runtime", "anchor": "section_runtime", "level": 1 },
                        { "id": "toc_static_dynamic", "label": "toc_row_static_dynamic", "anchor": "section_static_dynamic", "level": 1 },
                        { "id": "toc_mode_complete", "label": "toc_row_mode_complete", "anchor": "section_mode_complete", "level": 1 },
                        { "id": "toc_gotchas", "label": "toc_row_gotchas", "anchor": "section_gotchas", "level": 1 }
                      ],
                      "stickyOffset": 80
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
