                      "width": "matchParent",
                      "height": "wrapContent",
                      "topMargin": 8,
                      "code": "// web (rjui)\n<button id=\"open_button\" className=\"…\" onClick={() => data.onOpen?.()}\n        aria-label=\"Open the second image\">Open</button>\n\n// iOS (sjui, SwiftUI)\nStateAwareButtonView(\n    text: \"Open\",\n    action: { data.onOpen?() },\n    isEnabled: true\n)\n    .accessibilityIdentifier(\"open_button\")\n    .accessibilityLabel(Text(\"Open the second image\"))\n\n// Android (kjui, Compose)\nButton(onClick = { data.onOpen?.invoke() },\n    modifier = Modifier\n        .testTag(\"open_button\")\n        .semantics { testTagsAsResourceId = true }\n        .then((\"Open the second image\").let { label -> Modifier.semantics { contentDescription = label } }),\n    …) { Text(\"Open\") }",
                      "language": "text",
                      "filename": "generated (excerpts)",
                      "showLineNumbers": false,
                      "copyable": false
                    },
