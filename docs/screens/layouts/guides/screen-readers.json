                      "height": "wrapContent",
                      "topMargin": 8,
                      "code": "// layout\n{ \"type\": \"Label\", \"id\": \"save_status\", \"text\": \"@{saveStatus}\", \"accessibilityLiveRegion\": \"polite\" }\n{ \"type\": \"Label\", \"id\": \"save_error\",  \"text\": \"@{saveError}\",  \"accessibilityLiveRegion\": \"assertive\" }\n\n// web (rjui)\n<span id=\"save_status\" className=\"…\" role=\"status\" aria-live=\"polite\">{`${data.saveStatus ?? \"\"}`}</span>\n<span id=\"save_error\"  className=\"…\" role=\"alert\" aria-live=\"assertive\">{`${data.saveError ?? \"\"}`}</span>\n\n// Android (kjui, Compose) — on each Text's modifier\n.semantics { liveRegion = LiveRegionMode.Polite }\n.semantics { liveRegion = LiveRegionMode.Assertive }\n\n// iOS (sjui, SwiftUI) — save_status; save_error is the same with .high\n.onChange(of: (data.saveStatus ?? \"\")) { _, newValue in\n    var announcement = AttributedString(newValue)\n    announcement.accessibilitySpeechAnnouncementPriority = .default\n    AccessibilityNotification.Announcement(announcement).post()\n}",
                      "language": "text",
                      "filename": "generated (excerpts)",
                      "showLineNumbers": false,
                      "copyable": false
