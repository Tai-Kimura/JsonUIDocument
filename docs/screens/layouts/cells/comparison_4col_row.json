{
  "type": "View",
  "orientation": "horizontal",
  "width": "matchParent",
  "height": "wrapContent",
  "paddings": [12, 16, 12, 16],
  "background": "#FFFFFF",
  "cornerRadius": 8,
  "borderWidth": 1,
  "borderColor": "#E5E7EB",
  "child": [
    {
      "data": [
        { "name": "labelKey",   "class": "String" },
        { "name": "moshiKey",   "class": "String" },
        { "name": "kotlinxKey", "class": "String" },
        { "name": "noneKey",    "class": "String" }
      ]
    },
    {
      "type": "Label",
      "weight": 1,
      "height": "wrapContent",
      "fontSize": 13,
      "fontWeight": "semibold",
      "fontColor": "#0B1220",
      "text": "@{labelKey}"
    },
    {
      "type": "Label",
      "weight": 1,
      "height": "wrapContent",
      "leftMargin": 8,
      "fontSize": 13,
      "fontColor": "#475467",
      "text": "@{moshiKey}"
    },
    {
      "type": "Label",
      "weight": 1,
      "height": "wrapContent",
      "leftMargin": 8,
      "fontSize": 13,
      "fontColor": "#475467",
      "text": "@{kotlinxKey}"
    },
    {
      "type": "Label",
      "weight": 1,
      "height": "wrapContent",
      "leftMargin": 8,
      "fontSize": 13,
      "fontColor": "#475467",
      "text": "@{noneKey}"
    }
  ]
}
