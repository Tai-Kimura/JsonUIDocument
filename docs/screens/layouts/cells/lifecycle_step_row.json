{
  "type": "View",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "wrapContent",
  "paddings": [12, 16, 12, 16],
  "background": "#FFFFFF",
  "cornerRadius": 10,
  "borderWidth": 1,
  "borderColor": "#E5E7EB",
  "child": [
    {
      "data": [
        { "name": "stepKey", "class": "String" },
        { "name": "bodyKey", "class": "String" }
      ]
    },
    {
      "type": "Label",
      "width": "matchParent",
      "height": "wrapContent",
      "fontSize": 15,
      "fontWeight": "semibold",
      "fontColor": "#0B1220",
      "text": "@{stepKey}"
    },
    {
      "type": "Label",
      "width": "matchParent",
      "height": "wrapContent",
      "topMargin": 6,
      "fontSize": 13,
      "fontColor": "#475467",
      "text": "@{bodyKey}"
    }
  ]
}
