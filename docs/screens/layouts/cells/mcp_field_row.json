{
  "type": "View",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "wrapContent",
  "paddings": [12, 16, 12, 16],
  "background": "#FFFFFF",
  "cornerRadius": 10,
  "borderWidth": 1,
  "borderColor": "#E5E7EB",
  "child": [
    {
      "data": [
        { "name": "toolKey",  "class": "String" },
        { "name": "fieldKey", "class": "String" },
        { "name": "typeKey",  "class": "String" },
        { "name": "bodyKey",  "class": "String" }
      ]
    },
    {
      "type": "View",
      "orientation": "horizontal",
      "width": "matchParent",
      "height": "wrapContent",
      "alignment": "centerVertical",
      "child": [
        {
          "type": "Label",
          "width": "wrapContent",
          "height": "wrapContent",
          "paddings": [2, 8, 2, 8],
          "fontSize": 11,
          "fontWeight": "bold",
          "fontColor": "#1E3A8A",
          "background": "#DBEAFE",
          "cornerRadius": 6,
          "text": "@{toolKey}"
        },
        {
          "type": "Label",
          "weight": 1,
          "height": "wrapContent",
          "leftMargin": 10,
          "fontSize": 14,
          "fontWeight": "bold",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, monospace",
          "fontColor": "#0B1220",
          "text": "@{fieldKey}"
        },
        {
          "type": "Label",
          "width": "wrapContent",
          "height": "wrapContent",
          "leftMargin": 8,
          "paddings": [2, 8, 2, 8],
          "fontSize": 11,
          "fontWeight": "semibold",
          "fontColor": "#475467",
          "background": "#F3F4F6",
          "cornerRadius": 6,
          "text": "@{typeKey}"
        }
      ]
    },
    {
      "type": "Label",
      "width": "matchParent",
      "height": "wrapContent",
      "topMargin": 6,
      "fontSize": 13,
      "fontColor": "#475467",
      "text": "@{bodyKey}"
    }
  ]
}
