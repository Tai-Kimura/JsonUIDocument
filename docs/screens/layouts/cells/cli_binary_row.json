{
  "type": "View",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "wrapContent",
  "paddings": [14, 16, 14, 16],
  "background": "surface_card",
  "cornerRadius": 12,
  "borderWidth": 1,
  "borderColor": "border",
  "child": [
    {
      "data": [
        { "name": "name", "class": "String" },
        { "name": "meta", "class": "String" },
        { "name": "purpose", "class": "String" }
      ]
    },
    {
      "type": "View",
      "orientation": "horizontal",
      "width": "matchParent",
      "height": "wrapContent",
      "alignment": "centerVertical",
      "child": [
        {
          "type": "Label",
          "width": "wrapContent",
          "height": "wrapContent",
          "fontSize": 16,
          "fontWeight": "bold",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, monospace",
          "fontColor": "ink",
          "text": "@{name}"
        },
        {
          "type": "Label",
          "weight": 1,
          "height": "wrapContent",
          "leftMargin": 12,
          "fontSize": 12,
          "fontColor": "ink_subtle",
          "text": "@{meta}"
        }
      ]
    },
    {
      "type": "Label",
      "width": "matchParent",
      "height": "wrapContent",
      "topMargin": 6,
      "fontSize": 14,
      "fontColor": "ink_muted",
      "text": "@{purpose}"
    }
  ]
}
