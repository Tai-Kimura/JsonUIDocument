{
  "type": "View",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "wrapContent",
  "paddings": [16, 18, 16, 18],
  "background": "#FFFFFF",
  "cornerRadius": 12,
  "borderWidth": 1,
  "borderColor": "#E5E7EB",
  "child": [
    {
      "data": [
        { "name": "nameKey",    "class": "String" },
        { "name": "roleKey",    "class": "String" },
        { "name": "useCaseKey", "class": "String" }
      ]
    },
    {
      "type": "Label",
      "width": "matchParent",
      "height": "wrapContent",
      "fontSize": 16,
      "fontWeight": "bold",
      "fontFamily": "ui-monospace, SFMono-Regular, Menlo, monospace",
      "fontColor": "#0B1220",
      "text": "@{nameKey}"
    },
    {
      "type": "Label",
      "width": "matchParent",
      "height": "wrapContent",
      "topMargin": 6,
      "fontSize": 13,
      "fontWeight": "semibold",
      "fontColor": "#1E3A8A",
      "text": "@{roleKey}"
    },
    {
      "type": "Label",
      "width": "matchParent",
      "height": "wrapContent",
      "topMargin": 6,
      "fontSize": 13,
      "fontColor": "#475467",
      "text": "@{useCaseKey}"
    }
  ]
}
