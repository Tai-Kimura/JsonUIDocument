{
  "type": "View",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "wrapContent",
  "paddings": [12, 16, 12, 16],
  "background": "#FFFFFF",
  "cornerRadius": 10,
  "borderWidth": 1,
  "borderColor": "#E5E7EB",
  "child": [
    {
      "data": [
        { "name": "keyKey",         "class": "String" },
        { "name": "typeKey",        "class": "String" },
        { "name": "defaultKey",     "class": "String" },
        { "name": "globKey",        "class": "String" },
        { "name": "descriptionKey", "class": "String" }
      ]
    },
    {
      "type": "View",
      "orientation": "horizontal",
      "width": "matchParent",
      "height": "wrapContent",
      "alignment": "centerVertical",
      "child": [
        {
          "type": "Label",
          "weight": 1,
          "height": "wrapContent",
          "fontSize": 14,
          "fontWeight": "bold",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, monospace",
          "fontColor": "#0B1220",
          "text": "@{keyKey}"
        },
        {
          "type": "Label",
          "width": "wrapContent",
          "height": "wrapContent",
          "leftMargin": 8,
          "paddings": [2, 8, 2, 8],
          "fontSize": 11,
          "fontWeight": "semibold",
          "fontColor": "#475467",
          "background": "#F3F4F6",
          "cornerRadius": 6,
          "text": "@{typeKey}"
        },
        {
          "type": "Label",
          "width": "wrapContent",
          "height": "wrapContent",
          "leftMargin": 8,
          "paddings": [2, 8, 2, 8],
          "fontSize": 11,
          "fontWeight": "semibold",
          "fontColor": "#4F46E5",
          "background": "#EEF2FF",
          "cornerRadius": 6,
          "text": "@{globKey}"
        }
      ]
    },
    {
      "type": "Label",
      "width": "matchParent",
      "height": "wrapContent",
      "topMargin": 6,
      "fontSize": 12,
      "fontWeight": "semibold",
      "fontColor": "#64748B",
      "text": "@{defaultKey}"
    },
    {
      "type": "Label",
      "width": "matchParent",
      "height": "wrapContent",
      "topMargin": 4,
      "fontSize": 13,
      "fontColor": "#475467",
      "text": "@{descriptionKey}"
    }
  ]
}
