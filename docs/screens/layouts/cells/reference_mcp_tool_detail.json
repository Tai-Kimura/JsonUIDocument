{
  "type": "View",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "wrapContent",
  "paddings": [16, 18, 16, 18],
  "background": "#FFFFFF",
  "cornerRadius": 12,
  "borderWidth": 1,
  "borderColor": "#E5E7EB",
  "child": [
    {
      "data": [
        { "name": "nameKey",           "class": "String" },
        { "name": "groupKey",          "class": "String" },
        { "name": "roleKey",           "class": "String" },
        { "name": "paramsCode",        "class": "String", "defaultValue": "" },
        { "name": "paramsHeadingKey",  "class": "String", "defaultValue": "" }
      ]
    },
    {
      "type": "View",
      "orientation": "horizontal",
      "width": "matchParent",
      "height": "wrapContent",
      "alignment": "centerVertical",
      "child": [
        {
          "type": "Label",
          "width": "wrapContent",
          "height": "wrapContent",
          "paddings": [3, 10, 3, 10],
          "fontSize": 12,
          "fontWeight": "semibold",
          "fontColor": "#4F46E5",
          "background": "#EEF2FF",
          "cornerRadius": 999,
          "text": "@{groupKey}"
        },
        {
          "type": "Label",
          "weight": 1,
          "height": "wrapContent",
          "leftMargin": 12,
          "fontSize": 17,
          "fontWeight": "bold",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, monospace",
          "fontColor": "#0B1220",
          "text": "@{nameKey}"
        }
      ]
    },
    {
      "type": "Label",
      "width": "matchParent",
      "height": "wrapContent",
      "topMargin": 6,
      "fontSize": 14,
      "fontColor": "#475467",
      "text": "@{roleKey}"
    },
    {
      "type": "Label",
      "width": "matchParent",
      "height": "wrapContent",
      "topMargin": 12,
      "fontSize": 12,
      "fontWeight": "semibold",
      "fontColor": "#64748B",
      "text": "@{paramsHeadingKey}"
    },
    {
      "type": "CodeBlock",
      "width": "matchParent",
      "height": "wrapContent",
      "topMargin": 6,
      "code": "@{paramsCode}",
      "language": "text",
      "filename": "",
      "showLineNumbers": false,
      "copyable": false
    }
  ]
}
