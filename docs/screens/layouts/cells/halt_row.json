{
  "type": "View",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "wrapContent",
  "paddings": [12, 16, 12, 16],
  "background": "#FFFBEB",
  "cornerRadius": 10,
  "borderWidth": 1,
  "borderColor": "#FCD34D",
  "child": [
    {
      "data": [
        { "name": "triggerKey",    "class": "String" },
        { "name": "behaviorKey",   "class": "String" },
        { "name": "workaroundKey", "class": "String" }
      ]
    },
    {
      "type": "Label",
      "width": "wrapContent",
      "height": "wrapContent",
      "paddings": [2, 8, 2, 8],
      "fontSize": 11,
      "fontWeight": "bold",
      "fontColor": "#92400E",
      "background": "#FEF3C7",
      "cornerRadius": 6,
      "text": "@{triggerKey}"
    },
    {
      "type": "Label",
      "width": "matchParent",
      "height": "wrapContent",
      "topMargin": 8,
      "fontSize": 13,
      "fontWeight": "semibold",
      "fontColor": "#0B1220",
      "text": "@{behaviorKey}"
    },
    {
      "type": "Label",
      "width": "matchParent",
      "height": "wrapContent",
      "topMargin": 4,
      "fontSize": 13,
      "fontColor": "#475467",
      "text": "@{workaroundKey}"
    }
  ]
}
