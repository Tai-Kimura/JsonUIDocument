{
  "type": "View",
  "orientation": "horizontal",
  "width": "matchParent",
  "height": "wrapContent",
  "paddings": [12, 16, 12, 16],
  "background": "#FFFFFF",
  "cornerRadius": 8,
  "borderWidth": 1,
  "borderColor": "#E5E7EB",
  "child": [
    {
      "data": [
        { "name": "orderKey", "class": "String" },
        { "name": "ruleKey",  "class": "String" },
        { "name": "bodyKey",  "class": "String" }
      ]
    },
    {
      "type": "Label",
      "width": "wrapContent",
      "height": "wrapContent",
      "paddings": [2, 10, 2, 10],
      "fontSize": 12,
      "fontWeight": "bold",
      "fontColor": "pure_white",
      "background": "#1F2937",
      "cornerRadius": 999,
      "text": "@{orderKey}"
    },
    {
      "type": "View",
      "orientation": "vertical",
      "weight": 1,
      "leftMargin": 12,
      "height": "wrapContent",
      "child": [
        {
          "type": "Label",
          "width": "matchParent",
          "height": "wrapContent",
          "fontSize": 14,
          "fontWeight": "semibold",
          "fontColor": "#0B1220",
          "text": "@{ruleKey}"
        },
        {
          "type": "Label",
          "width": "matchParent",
          "height": "wrapContent",
          "topMargin": 4,
          "fontSize": 13,
          "fontColor": "#475467",
          "text": "@{bodyKey}"
        }
      ]
    }
  ]
}
