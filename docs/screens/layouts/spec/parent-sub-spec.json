{
  "type": "View",
  "id": "spec_parent_sub_spec_root",
  "orientation": "vertical",
  "width": "matchParent",
  "height": "matchParent",
  "background": "surface_muted",
  "child": [
    {
      "data": [
        {
          "name": "nextReadLinks",
          "class": "CollectionDataSource"
        },
        {
          "name": "onNavigateSpec",
          "class": "() -> Void"
        }
      ]
    },
    {
      "type": "Scroll",
      "id": "spec_parent_sub_spec_scroll",
      "width": "matchParent",
      "weight": 1,
      "child": [
        {
          "type": "View",
          "orientation": "vertical",
          "id": "spec_parent_sub_spec_header",
          "style": "page_header",
          "child": [
            {
              "type": "Label",
              "height": "wrapContent",
              "width": "wrapContent",
              "fontSize": 13,
              "fontWeight": "semibold",
              "fontColor": "#64748B",
              "tapBackground": "#F3F4F6",
              "onClick": "@{onNavigateSpec}",
              "text": "breadcrumb"
            },
            {
              "type": "Label",
              "width": "matchParent",
              "height": "wrapContent",
              "topMargin": 16,
              "fontSize": 36,
              "fontWeight": "bold",
              "fontColor": "#0B1220",
              "text": "title"
            },
            {
              "type": "Label",
              "width": "matchParent",
              "height": "wrapContent",
              "topMargin": 16,
              "fontSize": 17,
              "fontColor": "#475467",
              "text": "lead"
            },
            {
              "type": "Label",
              "width": "matchParent",
              "height": "wrapContent",
              "topMargin": 12,
              "fontSize": 13,
              "fontColor": "#64748B",
              "text": "read_time"
            }
          ]
        },
        {
          "type": "View",
          "orientation": "vertical",
          "id": "spec_parent_sub_spec_body",
          "width": "matchParent",
          "height": "wrapContent",
          "child": [
            {
              "type": "View",
              "orientation": "vertical",
              "id": "section_when",
              "style": "home_section",
              "background": "surface_card",
              "child": [
                {
                  "type": "Label",
                  "style": "section_heading",
                  "text": "section_when_heading",
                  "width": "matchParent"
                },
                {
                  "type": "Label",
                  "style": "section_subheading",
                  "text": "section_when_body",
                  "width": "matchParent"
                }
              ]
            },
            {
              "type": "View",
              "orientation": "vertical",
              "id": "section_parent",
              "style": "home_section",
              "background": "surface_muted",
              "child": [
                {
                  "type": "Label",
                  "style": "section_heading",
                  "text": "section_parent_heading",
                  "width": "matchParent"
                },
                {
                  "type": "Label",
                  "style": "section_subheading",
                  "text": "section_parent_body",
                  "width": "matchParent"
                },
                {
                  "type": "CodeBlock",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "topMargin": 16,
                  "code": "// chat.spec.json — the parent. Since 1.7.6 it is a container: a name, a\n// roster, and prose. Anything describing behaviour belongs in a sub.\n{\n  \"type\":    \"screen_parent_spec\",\n  \"version\": \"1.0\",\n  \"metadata\": {\n    \"name\":        \"Chat\",\n    \"displayName\": \"Chat\",\n    \"description\": \"Chat screen (composer + streaming transcript).\",\n    \"platforms\":   [\"ios\", \"android\", \"web\"],\n    \"layoutFile\":  \"chat\"          // subs inherit this\n  },\n  \"subSpecs\": [\n    { \"file\": \"chat/chat-core.spec.json\",      \"name\": \"ChatCore\" },\n    { \"file\": \"chat/chat-streaming.spec.json\", \"name\": \"ChatStreaming\" }\n  ],\n  \"structure\": { \"notes\": \"Prose about the tree — parent only.\" },\n  \"notes\": [\"Parent notes come first in the merged list.\"]\n}",
                  "language": "json",
                  "filename": "chat.spec.json (parent)",
                  "showLineNumbers": false,
                  "copyable": true
                }
              ]
            },
            {
              "type": "View",
              "orientation": "vertical",
              "id": "section_sub",
              "style": "home_section",
              "background": "surface_card",
              "child": [
                {
                  "type": "Label",
                  "style": "section_heading",
                  "text": "section_sub_heading",
                  "width": "matchParent"
                },
                {
                  "type": "Label",
                  "style": "section_subheading",
                  "text": "section_sub_body",
                  "width": "matchParent"
                },
                {
                  "type": "CodeBlock",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "topMargin": 16,
                  "code": "// chat/chat-core.spec.json — one sub. Everything that describes\n// behaviour lives here, including the branchContracts for its own\n// viewModel methods.\n{\n  \"type\":    \"screen_sub_spec\",\n  \"version\": \"1.0\",\n  \"metadata\": {\n    \"name\":       \"ChatCore\",\n    \"description\": \"Composer + send path.\",\n    \"parentSpec\": \"../chat.spec.json\"      // relative to this file\n  },\n  \"stateManagement\": { \"uiVariables\": [ /* … */ ], \"eventHandlers\": [ /* … */ ] },\n  \"dataFlow\": {\n    \"viewModel\":    { \"methods\": [ { \"name\": \"send\", /* … */ } ] },\n    \"repositories\": [ { \"name\": \"ChatRepository\", \"methods\": [ /* … */ ] } ]\n  },\n  \"branchContracts\": [ /* the contracts for send(), beside send() */ ],\n  \"userActions\": [ /* … */ ],\n  \"transitions\": [ /* … */ ]\n}",
                  "language": "json",
                  "filename": "chat/chat-core.spec.json (sub)",
                  "showLineNumbers": false,
                  "copyable": true
                }
              ]
            },
            {
              "type": "View",
              "orientation": "vertical",
              "id": "section_inherited",
              "style": "home_section",
              "background": "surface_muted",
              "child": [
                {
                  "type": "Label",
                  "style": "section_heading",
                  "text": "section_inherited_heading",
                  "width": "matchParent"
                },
                {
                  "type": "Label",
                  "style": "section_subheading",
                  "text": "section_inherited_body",
                  "width": "matchParent"
                },
                {
                  "type": "CodeBlock",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "topMargin": 16,
                  "code": "Where each section is declared — derived by running the merger, not by hand:\n\nsection                                          parent   sub\n-------                                          ------   ---\ntype / version / metadata / subSpecs             only     –\nstructure.notes                                  only     –\nrelatedFiles, notes                              yes      yes    (parent first)\nstructure.components, structure.rootComponents   ERROR    supplies\nstateManagement.uiVariables                      ERROR    supplies\nstateManagement.eventHandlers, displayLogic      ERROR    supplies\ndataFlow.viewModel                               ERROR    supplies\ndataFlow.repositories, useCases, apiEndpoints    ERROR    supplies\nuserActions, transitions                         ERROR    supplies\nbranchContracts                                  ERROR    supplies\nerror_handling, task_cancellation                ERROR    supplies\n\nmetadata.layoutFile and metadata.platforms are declared once, in the\nparent, and inherited by every sub.",
                  "language": "text",
                  "filename": "where each section goes",
                  "showLineNumbers": false,
                  "copyable": false
                }
              ]
            },
            {
              "type": "View",
              "orientation": "vertical",
              "id": "section_merge",
              "style": "home_section",
              "background": "surface_card",
              "child": [
                {
                  "type": "Label",
                  "style": "section_heading",
                  "text": "section_merge_heading",
                  "width": "matchParent"
                },
                {
                  "type": "Label",
                  "style": "section_subheading",
                  "text": "section_merge_body",
                  "width": "matchParent"
                },
                {
                  "type": "CodeBlock",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "topMargin": 16,
                  "code": "// What `jui build` does with a parent + sub group:\n//\n// 1. Read chat.spec.json      → discover subSpecs[] roster\n// 2. Reject any behavioural section declared in the parent\n// 3. For each sub:\n//      a. Validate against the screen_sub_spec schema\n//      b. Resolve parentSpec  → inherit layoutFile + platforms\n// 4. Merge the subs' sections into one spec:\n//      keyed sections   → matched by name across subs\n//        identical      → one entry\n//        different      → conflict, first one seen wins, build continues\n//      listed sections  → concatenated in roster order\n// 5. Generate from the merged spec\n//\n// A conflict, as the merger words it:\n//   dataFlow.viewModel.methods[name=send]:\n//     Defined differently in 'ChatCore' and 'ChatStreaming'",
                  "language": "text",
                  "filename": "jui build merge flow",
                  "showLineNumbers": false,
                  "copyable": false
                }
              ]
            },
            {
              "type": "View",
              "orientation": "vertical",
              "id": "section_migrate",
              "style": "home_section",
              "background": "surface_card",
              "width": "matchParent",
              "height": "wrapContent",
              "child": [
                {
                  "type": "Label",
                  "style": "section_heading",
                  "text": "section_migrate_heading",
                  "width": "matchParent"
                },
                {
                  "type": "Label",
                  "style": "section_subheading",
                  "text": "section_migrate_body",
                  "width": "matchParent"
                },
                {
                  "type": "Label",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "topMargin": 16,
                  "fontSize": 13,
                  "fontColor": "#64748B",
                  "text": "section_migrate_caption"
                },
                {
                  "type": "CodeBlock",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "topMargin": 8,
                  "code": "1. jsonui-doc validate spec docs/screens/json/chat.spec.json\n     → every forbidden section, one error each\n\n2. move each section into the sub-spec whose feature it belongs to\n     → a branchContracts entry goes beside the method it constrains\n\n3. jui build && jui verify\n     → read the diff: the output is expected to GROW, not to match",
                  "language": "text",
                  "filename": "migration",
                  "showLineNumbers": false,
                  "copyable": false
                },
                {
                  "type": "Label",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "topMargin": 16,
                  "fontSize": 14,
                  "fontColor": "#475467",
                  "text": "section_migrate_bullet_error"
                },
                {
                  "type": "Label",
                  "width": "matchParent",
                  "height": "wrapContent",
                  "topMargin": 6,
                  "fontSize": 14,
                  "fontColor": "#475467",
                  "text": "section_migrate_bullet_silent"
                }
              ]
            },
            {
              "type": "View",
              "orientation": "vertical",
              "id": "section_antipatterns",
              "style": "home_section",
              "background": "surface_muted",
              "child": [
                {
                  "type": "Label",
                  "style": "section_heading",
                  "text": "section_antipatterns_heading",
                  "width": "matchParent"
                },
                {
                  "type": "Label",
                  "style": "section_subheading",
                  "text": "section_antipatterns_body",
                  "width": "matchParent"
                }
              ]
            }
          ]
        },
        {
          "type": "View",
          "orientation": "vertical",
          "id": "spec_parent_sub_spec_next",
          "style": "home_section",
          "background": "chrome_fill",
          "child": [
            {
              "type": "Label",
              "style": "section_heading",
              "text": "next_heading",
              "width": "matchParent",
              "fontColor": "chrome_ink"
            },
            {
              "type": "Label",
              "style": "section_subheading",
              "text": "next_subheading",
              "width": "matchParent",
              "fontColor": "chrome_ink"
            },
            {
              "type": "Collection",
              "id": "spec_parent_sub_spec_next_collection",
              "width": "matchParent",
              "height": "wrapContent",
              "topMargin": 24,
              "columnCount": 2,
              "lineSpacing": 16,
              "itemSpacing": 16,
              "lazy": "none",
              "scrollEnabled": false,
              "items": "@{nextReadLinks}",
              "cellIdProperty": "id",
              "sections": [
                {
                  "cell": "cells/next_step_card"
                }
              ]
            }
          ]
        },
        {
          "type": "View",
          "id": "spec_parent_sub_spec_footer",
          "width": "matchParent",
          "height": "wrapContent",
          "paddings": [
            24,
            32,
            32,
            32
          ],
          "background": "chrome_fill",
          "child": [
            {
              "type": "Label",
              "width": "matchParent",
              "height": "wrapContent",
              "fontSize": 12,
              "fontColor": "#94A3B8",
              "text": "footer_copyright"
            }
          ]
        }
      ]
    }
  ]
}
