{
  "type": "screen_spec",
  "version": "1.0",
  "metadata": {
    "name": "VizIndex",
    "displayName": "jui viz: watch your agents work",
    "description": "jui viz > Overview. One article of the /viz section, split out of /tools/viz on 2026-10-24. Sections: What it shows / It stays on your machine / Which article to read. Written from the former /tools/viz text and checked against jsonui-cli 2.3.20.",
    "platforms": [
      "web"
    ],
    "layoutFile": "viz_index",
    "createdAt": "2026-10-24",
    "updatedAt": "2026-10-24"
  },
  "structure": {
    "components": [],
    "customComponents": [
      {
        "name": "VizDemo",
        "specFile": "viz-demo.component.json",
        "description": "The jui viz demo in an iframe."
      }
    ],
    "layout": {},
    "collection": null,
    "tabView": null
  },
  "stateManagement": {
    "states": [],
    "uiVariables": [
      {
        "name": "nextReadLinks",
        "type": "[NextReadLink]",
        "initial": "[]",
        "description": "Closing 'keep reading' cards."
      },
      {
        "name": "articleLinks",
        "type": "[NextReadLink]",
        "initial": "[]",
        "description": "One card per article in the section."
      }
    ],
    "eventHandlers": [
      {
        "name": "onAppear",
        "description": "Seed the card collections."
      },
      {
        "name": "onNavigate",
        "params": [
          {
            "name": "url",
            "type": "String"
          }
        ],
        "description": "Client-side navigation."
      }
    ],
    "displayLogic": []
  },
  "dataFlow": {
    "diagram": "flowchart TD\n    VIEW --> VM",
    "viewModel": {
      "methods": [
        {
          "name": "onAppear",
          "description": "Seed the card collections from a static catalog; each title / description is resolved through StringManager with the viz_index_ prefix."
        },
        {
          "name": "onNavigate",
          "params": [
            {
              "name": "url",
              "type": "String"
            }
          ],
          "description": "router.push(url). Destinations: /viz/setup, /viz/room, /viz/spirits, /viz/panels, /viz/sessions, /viz/approvals, /viz/tests, /viz/server-room, /viz/infra-model, /viz/cost, /tools."
        }
      ],
      "vars": [
        {
          "name": "nextReadLinks",
          "type": "Array(NextReadLink)",
          "observable": true,
          "description": "Closing 'keep reading' cards."
        },
        {
          "name": "articleLinks",
          "type": "Array(NextReadLink)",
          "observable": true,
          "description": "One card per article in the section."
        }
      ]
    },
    "repositories": [],
    "useCases": [],
    "apiEndpoints": [],
    "customTypes": [
      {
        "name": "NextReadLink",
        "properties": [
          {
            "name": "id",
            "type": "String"
          },
          {
            "name": "titleKey",
            "type": "String"
          },
          {
            "name": "descriptionKey",
            "type": "String"
          },
          {
            "name": "url",
            "type": "String"
          }
        ]
      }
    ]
  },
  "userActions": [
    {
      "action": "Tap a TOC entry",
      "processing": "TOC-internal scroll."
    },
    {
      "action": "Tap a card",
      "processing": "onNavigate(url)."
    }
  ],
  "validation": {
    "clientSide": [],
    "serverSide": []
  },
  "transitions": [
    {
      "trigger": "onNavigate(url)",
      "condition": "url is spec-mapped",
      "destination": "Target screen",
      "description": "v1: /viz/setup, /viz/room, /viz/spirits, /viz/panels, /viz/sessions, /viz/approvals, /viz/tests, /viz/server-room, /viz/infra-model, /viz/cost, /tools."
    }
  ],
  "relatedFiles": [
    {
      "type": "Layout",
      "path": "docs/screens/layouts/viz_index.json",
      "description": "Layout."
    },
    {
      "type": "ViewModel",
      "path": "jsonui-doc-web/src/viewmodels/viz/VizIndexViewModel.ts",
      "description": "VM."
    },
    {
      "type": "View",
      "path": "jsonui-doc-web/src/app/viz/page.tsx",
      "description": "Page."
    },
    {
      "type": "Component",
      "path": "jsonui-doc-web/src/components/extensions/VizDemo.tsx",
      "description": "The demo iframe."
    }
  ],
  "notes": [
    "Screenshots live in docs/screens/images/viz/ and are taken with sample data only.",
    "The demo is served from jsonui-doc-web/public/tools/viz-demo/<jsonui-cli version>/; see the VizDemo component spec."
  ]
}
