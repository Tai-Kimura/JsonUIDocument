{
  "type": "screen_spec",
  "version": "1.0",
  "metadata": {
    "name": "Setup",
    "displayName": "Set up jui viz",
    "description": "jui viz > Set up. One article of the /viz section, split out of /tools/viz on 2026-10-24. Sections: Install / Start it / Change the language / Update to a new version / Remove it / When it does not work / Safety. Written from the former /tools/viz text and checked against jsonui-cli 2.3.20.",
    "platforms": [
      "web"
    ],
    "layoutFile": "viz/setup",
    "createdAt": "2026-10-24",
    "updatedAt": "2026-10-24"
  },
  "structure": {
    "components": [],
    "customComponents": [],
    "layout": {},
    "collection": null,
    "tabView": null
  },
  "stateManagement": {
    "states": [],
    "uiVariables": [
      {
        "name": "nextReadLinks",
        "type": "[NextReadLink]",
        "initial": "[]",
        "description": "Closing 'keep reading' cards."
      }
    ],
    "eventHandlers": [
      {
        "name": "onAppear",
        "description": "Seed the card collections."
      },
      {
        "name": "onNavigate",
        "params": [
          {
            "name": "url",
            "type": "String"
          }
        ],
        "description": "Client-side navigation."
      }
    ],
    "displayLogic": []
  },
  "dataFlow": {
    "diagram": "flowchart TD\n    VIEW --> VM",
    "viewModel": {
      "methods": [
        {
          "name": "onAppear",
          "description": "Seed the card collections from a static catalog; each title / description is resolved through StringManager with the viz_setup_ prefix."
        },
        {
          "name": "onNavigate",
          "params": [
            {
              "name": "url",
              "type": "String"
            }
          ],
          "description": "router.push(url). Destinations: /viz, /viz/room."
        }
      ],
      "vars": [
        {
          "name": "nextReadLinks",
          "type": "Array(NextReadLink)",
          "observable": true,
          "description": "Closing 'keep reading' cards."
        }
      ]
    },
    "repositories": [],
    "useCases": [],
    "apiEndpoints": [],
    "customTypes": [
      {
        "name": "NextReadLink",
        "properties": [
          {
            "name": "id",
            "type": "String"
          },
          {
            "name": "titleKey",
            "type": "String"
          },
          {
            "name": "descriptionKey",
            "type": "String"
          },
          {
            "name": "url",
            "type": "String"
          }
        ]
      }
    ]
  },
  "userActions": [
    {
      "action": "Tap a TOC entry",
      "processing": "TOC-internal scroll."
    },
    {
      "action": "Tap a card",
      "processing": "onNavigate(url)."
    }
  ],
  "validation": {
    "clientSide": [],
    "serverSide": []
  },
  "transitions": [
    {
      "trigger": "onNavigate(url)",
      "condition": "url is spec-mapped",
      "destination": "Target screen",
      "description": "v1: /viz, /viz/room."
    }
  ],
  "relatedFiles": [
