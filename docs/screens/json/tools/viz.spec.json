{
  "type": "screen_spec",
  "version": "1.0",
  "metadata": {
    "name": "Viz",
    "displayName": "jui viz: watch your agents work",
    "description": "Tools > jui viz. Since 2026-10-24 a short page pointing at the /viz section (one article per feature), which the former long article was split into. One card per article.",
    "platforms": [
      "web"
    ],
    "layoutFile": "tools/viz",
    "createdAt": "2026-10-18",
    "updatedAt": "2026-10-24"
  },
  "structure": {
    "components": [],
    "customComponents": [],
    "layout": {},
    "collection": null,
    "tabView": null
  },
  "stateManagement": {
    "states": [],
    "uiVariables": [
      {
        "name": "articleLinks",
        "type": "[NextReadLink]",
        "initial": "[]",
        "description": "One card per /viz article."
      }
    ],
    "eventHandlers": [
      {
        "name": "onAppear",
        "description": "Seed articleLinks."
      },
      {
        "name": "onNavigate",
        "params": [
          {
            "name": "url",
            "type": "String"
          }
        ],
        "description": "Client-side navigation."
      }
    ],
    "displayLogic": []
  },
  "dataFlow": {
    "diagram": "flowchart TD\n    VIEW --> VM",
    "viewModel": {
      "methods": [
        {
          "name": "onAppear",
          "description": "Seed articleLinks from the static catalog of the /viz section (eleven rows). Each row's titleKey / descriptionKey is resolved through StringManager with the tools_viz_ namespace prefix."
        },
        {
          "name": "onNavigate",
          "params": [
            {
              "name": "url",
              "type": "String"
            }
          ],
          "description": "Client-side navigation via router.push(url). Destinations: /tools, /viz, /viz/setup, /viz/room, /viz/spirits, /viz/panels, /viz/sessions, /viz/approvals, /viz/tests, /viz/server-room, /viz/infra-model, /viz/cost."
        }
      ],
      "vars": [
        {
          "name": "articleLinks",
          "type": "Array(NextReadLink)",
          "observable": true,
          "description": "One card per /viz article. Seeded on appear and re-seeded on a language change."
        }
      ]
    },
    "repositories": [],
    "useCases": [],
    "apiEndpoints": [],
    "customTypes": [
      {
        "name": "NextReadLink",
        "properties": [
          {
            "name": "id",
            "type": "String"
          },
          {
            "name": "titleKey",
            "type": "String"
          },
          {
            "name": "descriptionKey",
            "type": "String"
          },
          {
            "name": "url",
            "type": "String"
          }
        ]
      }
    ]
  },
  "userActions": [
    {
      "action": "Tap an article card",
      "processing": "onNavigate(url)."
    }
  ],
  "validation": {
    "clientSide": [],
    "serverSide": []
  },
  "transitions": [
    {
      "trigger": "onNavigate(url)",
      "condition": "url is spec-mapped",
      "destination": "Target screen or tab",
      "description": "v1: /tools, /viz, /viz/setup, /viz/room, /viz/spirits, /viz/panels, /viz/sessions, /viz/approvals, /viz/tests, /viz/server-room, /viz/infra-model, /viz/cost."
    }
  ],
  "relatedFiles": [
    {
      "type": "Layout",
      "path": "docs/screens/layouts/tools/viz.json",
      "description": "Layout."
    },
    {
      "type": "ViewModel",
      "path": "jsonui-doc-web/src/viewmodels/tools/VizViewModel.ts",
      "description": "VM."
    },
    {
      "type": "View",
      "path": "jsonui-doc-web/src/app/tools/viz/page.tsx",
      "description": "Page."
    }
  ],
  "notes": [
    "The article this page used to hold lives in the /viz section (docs/screens/json/viz/). The live demo moved to /viz."
  ]
}
